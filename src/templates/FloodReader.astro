---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/chrome/Breadcrumb.astro';
import HowToReadThisPage from '~/components/HowToReadThisPage.astro';
import TraditionDivider from '~/components/TraditionDivider.astro';
import DropCap from '~/components/DropCap.astro';
import NarrativeMap from '~/components/visualizations/NarrativeMap.astro';
import MonomythArc from '~/components/visualizations/MonomythArc.astro';
import ProppMorphology from '~/components/visualizations/ProppMorphology.astro';
import MotifTagCloud from '~/components/visualizations/MotifTagCloud.astro';
import NextBestAction from '~/components/reader/NextBestAction.astro';
import ArtifactFigure from '~/components/epistemic/ArtifactFigure.astro';
import { t, type Locale } from '~/i18n';
import { floodReaderExtras } from '~/i18n/readers/gilgameshTabletReaders';
import { withBase } from '~/utils/url';
import { getEntry } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const fc = floodReaderExtras(locale);

const nas = 'nms://gilgamesh/tablet-xi/flood';
const parallelHref = withBase(`/${locale}/parallels/flood/`);

const episode = await getEntry('episodes', 'flood');
const proppFunctions = episode?.data.proppFunctions;
const campbellStages = episode?.data.campbellStages;
const tmiMotifs = episode?.data.tmiMotifs;
const nextHref = withBase(`/${locale}/gilgamesh/tablet-xi/sleep-challenge/`);
const tabletHref = withBase(`/${locale}/gilgamesh/tablet-xi/`);
const gilgameshHref = withBase(`/${locale}/gilgamesh/`);
---

<BaseLayout title={tr.frag_flood_title + tr.doc_title_suffix_tablet_xi_gilgamesh} locale={locale}>

  <div class="page-body">

    <!-- Breadcrumb -->
    <Breadcrumb locale={locale} crumbs={[
      { label: tr.bc_home, href: withBase(`/${locale}/`) },
      { label: tr.nav_gilgamesh, href: gilgameshHref },
      { label: tr.tablet_hub_breadcrumb, href: tabletHref },
      { label: tr.tab_ep1_name },
    ]} />

    <!-- NAS row -->
    <div class="nas-row" role="status" aria-live="polite">
      <span class="nas-addr" aria-label={`${tr.nas_address_aria_prefix}${nas}`}>{nas}</span>
      <button class="nas-copy" id="nas-copy-btn" aria-label={tr.copy_nas_aria}>
        {tr.copy_btn}
      </button>
      <span class="copied-confirm" id="copied-confirm" role="status" aria-live="polite">
        {tr.copied_confirm}
      </span>
    </div>

    <TraditionDivider tradition="mesopotamian" />

    <!-- Episode heading -->
    <div class="ep-heading">
      <h1 class="ep-title">{tr.frag_flood_title}</h1>
      <button class="badge ins" id="episode-badge" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_ai_reviewed}`} aria-expanded="false">
        <span>{tr.badge_ai_reviewed}</span>
        <div class="badge-pop" id="episode-badge-pop">
          <div class="pop-head">
            <span>{tr.badge_ai_reviewed}</span>
            <button type="button" class="pop-close">{tr.close_x}</button>
          </div>
          <p>{tr.frag_badge_ai_pop_p1}</p>
          <p>{tr.frag_badge_ai_pop_p2}</p>
          <ul>
            <li>{nas}{tr.frag_nas_tag_doc}</li>
          </ul>
        </div>
      </button>
    </div>
    <p class="ep-sub">{tr.frag_flood_subtitle}</p>

    <HowToReadThisPage locale={locale} />

    <!-- Layer indicator -->
    <div class="layer-indicator" role="tablist" id="layer-indicator" aria-label={tr.layer_depth_tablist_aria}>
      <button class="layer-tab" role="tab" id="tab-surface" aria-selected="true" aria-controls="layer-surface" data-layer="surface" data-track="layer-surface">
        <span class="layer-tab__plain">{tr.layer_surface_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_surface_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-narrated" aria-selected="false" aria-controls="layer-narrated" data-layer="narrated" data-track="layer-narrated">
        <span class="layer-tab__plain">{tr.layer_narrated_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_narrated_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-translated" aria-selected="false" aria-controls="layer-translated" data-layer="translated" data-track="layer-translated">
        <span class="layer-tab__plain">{tr.layer_translated_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_translated_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-original" aria-selected="false" aria-controls="layer-original" data-layer="original" data-track="layer-original">
        <span class="layer-tab__plain">{tr.layer_original_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_original_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-scholaria" aria-selected="false" aria-controls="layer-scholaria" data-layer="scholaria" data-track="layer-scholaria">
        <span class="layer-tab__plain">{tr.layer_scholaria_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_scholaria_poetic}</span>
      </button>
    </div>

    <!-- Content area -->
    <div class="content-area" id="content-area" tabindex="-1">

      <!-- ─── SURFACE LAYER ─── -->
      <div id="layer-surface" class="layer-panel active" role="tabpanel" aria-labelledby="tab-surface">
        <NarrativeMap episode="flood" locale={locale} tradition="mesopotamian" />
        <div class="ai-disclosure" role="note">
          <span>{tr.frag_ai_disclosure_lead}&nbsp;</span>
          <button type="button" class="disc-link" id="see-sources-btn" aria-expanded="false" aria-controls="sources-panel">
            {tr.see_sources}
          </button>
          <div class="sources-panel" id="sources-panel" role="region" aria-label={tr.sources_region_label}>
            <ul>
              <li>{nas}{tr.frag_nas_tag_doc}</li>
            </ul>
          </div>
        </div>
        <DropCap tradition="mesopotamian">{tr.frag_surf_flood_p1}</DropCap>
        <p class="body-p">{tr.frag_surf_flood_p2}</p>
        <p class="body-p">{tr.frag_surf_flood_p3}</p>
        <p class="body-p">{tr.frag_surf_flood_p4}</p>
      </div>

      <!-- ─── NARRATED LAYER ─── -->
      <div id="layer-narrated" class="layer-panel" role="tabpanel" aria-labelledby="tab-narrated">
        <p class="demo-marker">{tr.demo_content_marker}</p>
        <div class="narr-body">
          <p>{fc.narrP1}</p>
          <p>{fc.narrP2}</p>
          <blockquote class="narr-quote">
            <span set:html={fc.narrQuoteFenceHtml} />
            <cite class="narr-cite">{fc.narrQuoteFenceCite}</cite>
          </blockquote>
          <p>{fc.narrP3}</p>
          <blockquote class="narr-quote">
            <span set:html={fc.narrQuoteSecretHtml} />
            <cite class="narr-cite">{fc.narrQuoteSecretCite}</cite>
          </blockquote>
        </div>
      </div>

      <!-- ─── TRANSLATED LAYER ─── -->
      <div id="layer-translated" class="layer-panel" role="tabpanel" aria-labelledby="tab-translated">
        <div class="trans-header">
          <p style="font: 400 16px/1.5 var(--serif); margin-bottom: 4px;">{tr.frag_thompson_trans_credit}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 2px;" set:html={tr.frag_thompson_source_pub_dom_html} />
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">{tr.frag_thompson_cdli_reference}</p>
        </div>
        <div class="trans-passage" lang={locale === 'ru' ? 'ru' : 'en'}>
          {fc.transSegments.map((seg) =>
            seg.kind === 'lacuna' ? (
              <span class="lacuna" role="note" aria-label={seg.aria} set:html={seg.text} />
            ) : seg.kind === 'verse' ? (
              <p class="verse">{seg.text}</p>
            ) : (
              <p>{seg.text}</p>
            )
          )}
          <p class="trans-attribution">{fc.transAttribution}</p>
        </div>
      </div>

      <!-- ─── ORIGINAL LAYER ─── -->
      <div id="layer-original" class="layer-panel" role="tabpanel" aria-labelledby="tab-original">
        <p class="demo-marker">{tr.demo_content_marker}</p>
        <ArtifactFigure
          src={withBase('/assets/artifacts/tablet-xi-k3375.jpg')}
          tier="documented"
          institution="British Museum"
          accessionNumber="K.3375"
          license="CC BY-NC-SA 4.0"
          captionEn="Cuneiform tablet, Tablet XI of the Epic of Gilgamesh (Standard Babylonian Version). Neo-Assyrian period, 7th century BCE. Library of Ashurbanipal, Nineveh. The flood narrative occupies lines 1–196."
          captionRu="Клинописная табличка, Табличка XI Эпоса о Гильгамеше (Стандартная вавилонская версия). Нео-ассирийский период, VII в. до н.э. Библиотека Ашшурбанипала, Ниневия. Рассказ о потопе занимает строки 1–196."
          viewInCollectionUrl="https://www.britishmuseum.org/collection/object/W_K-3375"
          locale={locale}
          loading="lazy"
        />
        <div class="orig-header">
          <p style="font: 400 16px/1.5 var(--serif); margin-bottom: 4px;">{fc.origHeadMain}</p>
          <p class="orig-attr">{fc.origAttrGeorge}</p>
          <p class="orig-attr">{fc.origAttrNineveh}</p>
        </div>
        <pre class="orig-passage" lang="akk" dir="ltr">XI.9    ša gimrēti ašakkanam
XI.10   Šuruppak āla tīde
XI.11   ša ina kippat nāri mašil
XI.12   ālu šū labīru u ilāni libbuš
XI.13   libbā-šunu iš-te-'-u-ma rabûtu ilāni
XI.14   abūba eppišu ina kišādi-šunu

XI.22   bīt-ka šupur mākurri ibniš
XI.23   ù mimmê tuklatīka umazzi
XI.24   napšātka šuṣur
XI.25   zēr kala nišī ina mākurri šuqil

XI.36   Ea bēl-ī iqbâm-ma
XI.37   šumma annâ tēpuš
XI.38   lū-uṣ-ṣir lu-ub-ni

XI.68   kibrāti ana šāri isturrā-ma
XI.69   arki šamê arkī ikmi tenzâm
XI.70   ūmu ūm abūbi illikam-ma

XI.96   eli māti kīma qabli tallakt
XI.97   ūm abūbi šalšat ūm
XI.98   ikmi tenzâm ana mātim kī illikam</pre>
        <p class="orig-attr">{fc.origDemoNote}</p>
      </div>

      <!-- ─── SCHOLARIA LAYER ─── -->
      <div id="layer-scholaria" class="layer-panel" role="tabpanel" aria-labelledby="tab-scholaria">

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.schol_manuscript_status}</span>
            <button class="badge doc" style="cursor: default;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_documented}`}>{tr.badge_documented}</button>
          </div>
          <div class="schol-body">
            <p>{fc.scholMs}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.schol_textual_history}</span>
            <button class="badge rec" style="cursor: default;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_reconstructed}`}>{tr.badge_reconstructed}</button>
          </div>
          <div class="schol-body">
            <p>{fc.scholHist}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{fc.scholDebateHead}</span>
            <button class="badge con" style="cursor: default;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_contested}`}>{tr.badge_contested}</button>
          </div>
          <div class="schol-body">
            <p>{fc.scholDebateP}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_key_variants}</span></div>
          <div class="schol-body">
            <div class="schol-variant">
              <p>{fc.scholVariantLine14}</p>
              <p style="margin-top: 6px;"><button class="badge con" style="cursor: default; font-size: 10px;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_contested}`}>{tr.badge_contested}</button></p>
            </div>
            <div class="schol-variant">
              <p>{fc.scholVariantLines4555}</p>
              <p style="margin-top: 6px;"><button class="badge doc" style="cursor: default; font-size: 10px;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_documented}`}>{tr.badge_documented}</button></p>
            </div>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_visualization_tools}</span></div>
          <div class="schol-body">
            <MonomythArc stages={campbellStages} tradition="mesopotamian" locale={locale} />
            <ProppMorphology functions={proppFunctions} locale={locale} />
            <MotifTagCloud motifs={tmiMotifs} locale={locale} />
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_scholarship_cited}</span></div>
          <ul class="schol-cite">
            <li><span set:html={fc.scholCite1_html} /></li>
            <li><span set:html={fc.scholCite2_html} /></li>
            <li><span set:html={fc.scholCite3_html} /></li>
          </ul>
        </div>

      </div>

      <!-- Structure toggle -->
      <button type="button" class="structure-toggle" id="structure-toggle" aria-expanded="false" aria-controls="track-view">
        {tr.show_structure}
      </button>

    </div><!-- /content-area -->

    <!-- Track View -->
    <div class="track-view" id="track-view" role="region" aria-label={tr.track_region_aria} hidden aria-hidden="true">
      <p class="track-view-head">{tr.track_head_tablet_xi_flood}</p>

      <!-- Propp -->
      <div class="track-row">
        <div class="track-label">
          {tr.track_framework_label_propp}
          <button class="fw-help" aria-label={tr.help_propp_morphology_aria} data-explainer="exp-propp">[?]</button>
        </div>
        <div class="fw-explainer" id="exp-propp">
          <div class="fw-exp-head">{fc.proppFwTitle} <button class="fw-exp-close">{tr.close_x}</button></div>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{fc.proppFwBody}</p>
        </div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_propp_aria}>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-8: ${fc.propp8Name}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">PROPP-8</p>
            <p class="annot-name">{fc.propp8Name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.propp8PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.propp8PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
              <p class="meta-line">{tr.meta_nas_colon} {nas}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-15: ${fc.propp15Name}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">PROPP-15</p>
            <p class="annot-name">{fc.propp15Name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.propp15PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.propp15PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-19: ${fc.propp19Name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">PROPP-19</p>
            <p class="annot-name">{fc.propp19Name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.propp19PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.propp19PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-31: ${fc.propp31Name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">PROPP-31</p>
            <p class="annot-name">{fc.propp31Name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.propp31PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.propp31PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Campbell -->
      <div class="track-row">
        <div class="track-label">
          {tr.track_framework_label_campbell}
          <button class="fw-help" aria-label={tr.help_campbell_hero_aria} data-explainer="exp-campbell">[?]</button>
        </div>
        <div class="fw-explainer" id="exp-campbell">
          <div class="fw-exp-head">{fc.campFwTitle} <button class="fw-exp-close">{tr.close_x}</button></div>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{fc.campFwBody}</p>
        </div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_campbell_aria}>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`${fc.campCrossName}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">CAMPBELL</p>
            <p class="annot-name">{fc.campCrossName}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.campCrossPanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.campCrossPanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`${fc.campRoadName}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">CAMPBELL</p>
            <p class="annot-name">{fc.campRoadName}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.campRoadPanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.campRoadPanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- TMI -->
      <div class="track-row">
        <div class="track-label">
          {tr.track_label_tmi_paren}
          <button class="fw-help" aria-label={tr.help_thompson_motif_aria} data-explainer="exp-tmi">[?]</button>
        </div>
        <div class="fw-explainer" id="exp-tmi">
          <div class="fw-exp-head">{fc.tmiFwTitle} <button class="fw-exp-close">{tr.close_x}</button></div>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{fc.tmiFwBody}</p>
        </div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_tmi_aria}>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`A1010: ${fc.tmiA1010Name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">A1010</p>
            <p class="annot-name">{fc.tmiA1010Name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.tmiA1010PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.tmiA1010PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`A1021: ${fc.tmiA1021Name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">A1021</p>
            <p class="annot-name">{fc.tmiA1021Name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{fc.tmiA1021PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{fc.tmiA1021PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_kovacs}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Inactive tracks -->
      <div class="inactive-tracks">
        <button class="add-track" aria-pressed="false">{tr.inactive_track_bakhtin}</button>
        <button class="add-track" aria-pressed="false">{tr.inactive_track_levi_strauss}</button>
        <button class="add-track" aria-pressed="false">{tr.inactive_track_emotional_valence}</button>
      </div>
    </div><!-- /track-view -->

    <!-- Parallel strip (hidden by default; JS reveals after load) -->
    <div class="parallel-strip" id="parallel-strip" role="complementary" aria-label={tr.parallel_strip_region_aria} hidden>
      <div class="parallel-strip-head">
        <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{tr.parallel_strip_heading}</p>
      </div>
      <div class="parallel-card">
        <p style="margin-bottom: 10px;">
          <button class="badge doc" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_documented}`} aria-expanded="false">
            <span>{tr.badge_documented}</span>
            <div class="badge-pop">
              <div class="pop-head"><span>{tr.badge_documented}</span> <button type="button" class="pop-close">{tr.close_x}</button></div>
              <p>{tr.parallels_badge_doc_body}</p>
            </div>
          </button>
        </p>
        <h2 class="parallel-card-title">
          {tr.reader_parallel_card_flood_title}&nbsp;·&nbsp;<span style="font-weight: 400; color: var(--text-2);">{tr.reader_parallel_card_flood_subtitle}</span>
        </h2>
        <p class="parallel-card-body">{tr.parallel_flood_body}</p>
        <p class="parallel-card-type">{tr.parallel_type_shared}</p>
        <a href={parallelHref} aria-label={tr.parallel_read_flood_aria} style="font: 500 16px/1.7 var(--serif);">
          {tr.read_this_parallel}
        </a>
      </div>
    </div>

    <NextBestAction
      locale={locale}
      deeper={{ href: '#tab-narrated', label: tr.next_action_deeper_label, desc: tr.next_action_deeper_desc_flood }}
      parallel={{ href: parallelHref, label: tr.next_action_parallel_label, desc: tr.parallel_flood_heading }}
      next={{ href: nextHref, label: tr.next_action_next_ep_label, desc: tr.tab_ep2_name }}
    />

    <!-- Episode navigation -->
    <nav class="ep-nav" aria-label={tr.ep_nav_adjacent_aria}>
      <a href={tabletHref} rel="prev" aria-label={tr.ep_nav_prev_aria}>{tr.frag_nav_tablet_hub}</a>
      <a href={nextHref} rel="next" aria-label={tr.ep_nav_next_aria}>{tr.frag_nav_next_sleep}</a>
    </nav>

  </div><!-- /page-body -->

</BaseLayout>

<style>
  .page-body {
    padding-inline: var(--mx);
    padding-block: 40px 0;
    max-width: calc(var(--col) + var(--mx) * 2);
    margin-inline: auto;
  }

  /* NAS row */
  .nas-row { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .nas-addr { font: 400 11px/1.4 var(--mono); color: var(--text-3); }
  .nas-copy { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); text-decoration: underline; text-underline-offset: 2px; padding: 0; }
  .nas-copy:hover { color: var(--link-h); }
  .copied-confirm { font: 400 11px/1.4 var(--mono); color: var(--tier-doc); display: none; }

  /* Episode heading */
  .ep-heading { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 6px; }
  .ep-title { font: 500 24px/1.3 var(--serif); }
  .ep-sub { font: 400 14px/1.5 var(--serif); color: var(--text-3); margin-bottom: 0; }

  /* Badge */
  .badge {
    display: inline-flex; align-items: center; gap: 5px;
    font: 500 11px/1.4 var(--mono); padding: 2px 8px;
    border: 1px solid currentColor; border-radius: 2px;
    cursor: pointer; position: relative; user-select: none; background: transparent;
    vertical-align: middle;
  }
  .badge:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ins { color: var(--tier-ins); }
  .doc { color: var(--tier-doc); }
  .rec { color: var(--tier-rec); }
  .con { color: var(--tier-con); }
  .badge-pop {
    display: none; position: absolute; top: calc(100% + 6px); left: 0;
    width: min(300px, calc(100vw - 40px));
    background: var(--surface); border: 1px solid var(--border);
    padding: 14px 16px; z-index: 200;
    font: 400 14px/1.5 var(--serif); color: var(--text);
  }
  .badge-pop.open { display: block; }
  .pop-head { font: 500 11px/1.4 var(--mono); margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border-2); display: flex; justify-content: space-between; align-items: center; }
  .pop-close { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); padding: 0; }
  .badge-pop p { margin-bottom: 8px; }
  .badge-pop ul { list-style: none; margin-top: 6px; }
  .badge-pop li { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 3px; }
  .badge-pop li::before { content: "· "; }

  /* Layer tabs */
  .layer-indicator { display: flex; align-items: center; gap: 0; margin-bottom: 24px; padding: 10px 0; border-top: 1px solid var(--border-2); border-bottom: 1px solid var(--border-2); margin-top: 20px; }
  .layer-tab { background: none; border: none; cursor: pointer; font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 4px 0; display: flex; flex-direction: column; align-items: flex-start; gap: 1px; }
  .layer-tab__plain { font: 500 12px/1.3 var(--mono); }
  .layer-tab__poetic { font: 400 10px/1.3 var(--mono); color: var(--text-3); }
  .layer-tab[aria-selected="true"] .layer-tab__plain { color: var(--text); }
  .layer-tab[aria-selected="true"] .layer-tab__poetic { color: var(--text-2); }
  .layer-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .layer-sep { font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 0 12px; user-select: none; align-self: center; }

  /* Content area */
  .content-area { border: 1px solid var(--border-2); background: var(--surface); padding: 32px 36px; }
  .layer-panel { display: none; }
  .layer-panel.active { display: block; }

  /* AI disclosure */
  .ai-disclosure { font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border-2); }
  .disc-link { background: none; border: none; cursor: pointer; font: inherit; color: var(--link); text-decoration: underline; text-underline-offset: 2px; padding: 0; }
  .sources-panel { display: none; margin-top: 12px; background: var(--inset); padding: 12px 16px; }
  .sources-panel li { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 4px; list-style: none; }
  .sources-panel li::before { content: "· "; }

  /* Body text */
  .body-p { font: 400 16px/1.7 var(--serif); margin-bottom: 20px; }
  .body-p:last-of-type { margin-bottom: 0; }

  /* Demo marker */
  .demo-marker { font: 400 11px/1.4 var(--mono); color: var(--text-3); padding-bottom: 14px; margin-bottom: 20px; border-bottom: 1px solid var(--border-2); }

  /* Narrated layer */
  .narr-body p { font: 400 16px/1.7 var(--serif); margin-bottom: 20px; }
  .narr-body p:last-of-type { margin-bottom: 0; }
  .narr-quote { display: block; margin: 20px 0 20px 24px; padding-left: 16px; border-left: 2px solid var(--border); font: italic 16px/1.7 var(--serif); }
  .narr-cite { display: block; font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-top: 6px; font-style: normal; }

  /* Translated layer */
  .trans-header { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border-2); }
  .trans-passage { font: 400 16px/1.7 var(--serif); }
  .trans-passage p { margin-bottom: 16px; }
  .trans-passage .verse { margin-inline-start: 20px; margin-bottom: 4px; font-style: italic; }
  .lacuna { font: 400 italic 14px/1.5 var(--serif); color: var(--text-3); margin-block: 12px; display: block; }
  .trans-attribution { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-2); }

  /* Original layer */
  .orig-header { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border-2); }
  .orig-passage { font: 400 13px/1.6 var(--mono); white-space: pre; overflow-x: auto; background: var(--inset); padding: 20px 24px; margin-bottom: 12px; display: block; }
  .orig-attr { font: 400 11px/1.4 var(--mono); color: var(--text-3); }

  /* Scholaria */
  .schol-section { margin-bottom: 28px; }
  .schol-section:last-child { margin-bottom: 0; }
  .schol-head { font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; color: var(--text-2); margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-2); display: flex; align-items: center; gap: 12px; }
  .schol-body p { font: 400 16px/1.7 var(--serif); margin-bottom: 14px; }
  .schol-body p:last-child { margin-bottom: 0; }
  .schol-variant { font: 400 14px/1.5 var(--serif); margin-bottom: 10px; padding-inline-start: 16px; border-inline-start: 2px solid var(--border); }
  .schol-cite li { font: 400 14px/1.5 var(--serif); list-style: none; margin-bottom: 6px; color: var(--text-2); }
  .schol-cite li::before { content: "· "; }

  /* Structure toggle */
  .structure-toggle {
    display: block; background: none; border: none; cursor: pointer;
    font: 400 14px/1.5 var(--serif); color: var(--accent); padding: 0;
    margin-top: 24px; text-decoration: underline; text-underline-offset: 2px;
  }
  .structure-toggle:hover { color: var(--link-h); }
  .structure-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Track view */
  .track-view {
    display: none; background: var(--inset);
    border: 1px solid var(--border-2); border-top: none;
    padding: 24px 28px;
  }
  .track-view.open { display: block; }
  .track-view-head { font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; color: var(--text-2); margin-bottom: 20px; }
  .track-row { margin-bottom: 24px; }
  .track-row:last-of-type { margin-bottom: 0; }
  .track-label { font: 500 11px/1.4 var(--mono); color: var(--text-2); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .fw-help { background: none; border: 1px solid var(--border); border-radius: 2px; cursor: pointer; font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 1px 5px; }
  .fw-help:hover { color: var(--text); }
  .annot-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .annot-block {
    background: var(--surface); border: 1px solid var(--border-2);
    padding: 10px 12px; cursor: pointer; position: relative; min-width: 120px;
  }
  .annot-block:hover { background: var(--overlay); }
  .annot-block:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .annot-code { font: 500 11px/1.4 var(--mono); color: var(--text); margin-bottom: 3px; }
  .annot-name { font: 400 13px/1.4 var(--serif); color: var(--text-2); margin-bottom: 6px; }
  .annot-panel {
    display: none; position: absolute; top: calc(100% + 4px); left: 0; z-index: 150;
    width: min(320px, calc(100vw - 32px));
    background: var(--surface); border: 1px solid var(--border);
    padding: 14px 16px; font: 400 14px/1.5 var(--serif); color: var(--text);
  }
  .annot-panel.open { display: block; }
  .annot-panel-head { font: 500 11px/1.4 var(--mono); margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border-2); display: flex; justify-content: space-between; }
  .annot-panel-close { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); padding: 0; }
  .annot-panel p { margin-bottom: 8px; }
  .annot-panel .meta-line { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 4px; }
  .fw-explainer { display: none; margin-top: 8px; background: var(--surface); border: 1px solid var(--border-2); padding: 14px 16px; }
  .fw-explainer.open { display: block; }
  .fw-exp-head { font: 500 13px/1.4 var(--mono); margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border-2); display: flex; justify-content: space-between; }
  .fw-exp-close { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); padding: 0; }
  .inactive-tracks { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-2); }
  .add-track { background: none; border: 1px solid var(--border); border-radius: 2px; cursor: pointer; font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 3px 10px; }
  .add-track:hover { color: var(--text); }

  /* Parallel strip */
  .parallel-strip { border: 1px solid var(--border-2); margin-top: 16px; }
  .parallel-strip-head { background: var(--surface); padding: 14px 20px; border-bottom: 1px solid var(--border-2); }
  .parallel-card { padding: 20px; }
  .parallel-card-title { font: 400 18px/1.4 var(--serif); margin-bottom: 8px; }
  .parallel-card-body { font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 12px; }
  .parallel-card-type { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 14px; }

  /* Episode nav */
  .ep-nav { margin-top: 40px; display: flex; justify-content: space-between; align-items: center; padding-top: 24px; border-top: 1px solid var(--border-2); padding-bottom: 8px; }
  .ep-nav a { font: 400 14px/1.5 var(--serif); }

  @media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
  @media (max-width: 767px) {
    .page-body { padding-inline: var(--mx-m); }
    .content-area { padding: 20px 18px; }
    .annot-row { flex-direction: column; }
    .annot-block { min-width: auto; }
    .ep-nav { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
</style>

<script define:vars={{ showStructureLabel: tr.show_structure, hideStructureLabel: tr.hide_structure, seeSources: tr.see_sources, hideSources: tr.hide_sources, nasToCopy: nas, copiedText: tr.copied_confirm, layerPillAria: tr.layer_pill_aria }}>
  // ── Sticky layer pill ─────────────────────────────────────────────────
  const pill = document.createElement('div');
  pill.className = 'layer-pill';
  pill.setAttribute('aria-live', 'polite');
  pill.setAttribute('aria-label', layerPillAria);
  document.body.appendChild(pill);

  const layerIndicator = document.getElementById('layer-indicator');
  if (layerIndicator) {
    new IntersectionObserver(([e]) => {
      pill.classList.toggle('visible', !e.isIntersecting);
    }, { threshold: 0 }).observe(layerIndicator);
  }

  function updatePill(labelEl) {
    const plain = labelEl?.querySelector('.layer-tab__plain');
    if (plain) pill.textContent = plain.textContent ?? '';
  }
  // Init pill with first active tab
  updatePill(document.querySelector('.layer-tab[aria-selected="true"]'));

  // ── Layer switching ──────────────────────────────────────────────────
  document.querySelectorAll('.layer-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const layer = tab.dataset.layer;
      document.querySelectorAll('.layer-tab').forEach(t => t.setAttribute('aria-selected', 'false'));
      document.querySelectorAll('.layer-panel').forEach(p => p.classList.remove('active'));
      tab.setAttribute('aria-selected', 'true');
      const panel = document.getElementById('layer-' + layer);
      if (panel) panel.classList.add('active');
      updatePill(tab);
    });
  });

  // ── NAS copy ─────────────────────────────────────────────────────────
  const copyBtn = document.getElementById('nas-copy-btn');
  const copiedEl = document.getElementById('copied-confirm');
  if (copyBtn && copiedEl) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(nasToCopy).then(() => {
        copiedEl.style.display = 'inline';
        setTimeout(() => { copiedEl.style.display = 'none'; }, 2000);
      });
    });
  }

  // ── Sources panel toggle ──────────────────────────────────────────────
  const seeSrcBtn = document.getElementById('see-sources-btn');
  const sourcesPanel = document.getElementById('sources-panel');
  if (seeSrcBtn && sourcesPanel) {
    seeSrcBtn.addEventListener('click', () => {
      const open = sourcesPanel.style.display === 'block';
      sourcesPanel.style.display = open ? 'none' : 'block';
      seeSrcBtn.setAttribute('aria-expanded', String(!open));
      seeSrcBtn.textContent = open ? seeSources : hideSources;
    });
  }

  // ── Structure toggle ─────────────────────────────────────────────────
  const structureToggle = document.getElementById('structure-toggle');
  const trackView = document.getElementById('track-view');
  if (structureToggle && trackView) {
    structureToggle.addEventListener('click', () => {
      const open = trackView.classList.contains('open');
      trackView.classList.toggle('open', !open);
      trackView.hidden = open;
      trackView.setAttribute('aria-hidden', String(open));
      structureToggle.setAttribute('aria-expanded', String(!open));
      structureToggle.textContent = open ? showStructureLabel : hideStructureLabel;
    });
  }

  // ── Badge popups ──────────────────────────────────────────────────────
  document.querySelectorAll('.badge').forEach(badge => {
    const pop = badge.querySelector('.badge-pop');
    if (!pop) return;
    badge.addEventListener('click', e => {
      e.stopPropagation();
      const open = pop.classList.contains('open');
      document.querySelectorAll('.badge-pop').forEach(p => p.classList.remove('open'));
      if (!open) pop.classList.add('open');
      badge.setAttribute('aria-expanded', String(!open));
    });
    const closeBtn = pop.querySelector('.pop-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', e => {
        e.stopPropagation();
        pop.classList.remove('open');
        badge.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // ── Annotation block popups ───────────────────────────────────────────
  document.querySelectorAll('.annot-block').forEach(block => {
    const panel = block.querySelector('.annot-panel');
    if (!panel) return;
    block.addEventListener('click', e => {
      e.stopPropagation();
      const open = panel.classList.contains('open');
      document.querySelectorAll('.annot-panel').forEach(p => p.classList.remove('open'));
      document.querySelectorAll('.annot-block').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!open) {
        panel.classList.add('open');
        block.setAttribute('aria-expanded', 'true');
      }
    });
    block.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); block.click(); }
    });
    const closeBtn = panel.querySelector('.annot-panel-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', e => {
        e.stopPropagation();
        panel.classList.remove('open');
        block.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // ── Framework explainer toggles ───────────────────────────────────────
  document.querySelectorAll('.fw-help').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.explainer;
      const exp = id ? document.getElementById(id) : null;
      if (exp) exp.classList.toggle('open');
    });
  });
  document.querySelectorAll('.fw-exp-close').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.fw-explainer')?.classList.remove('open');
    });
  });

  // ── Inactive track buttons ────────────────────────────────────────────
  document.querySelectorAll('.add-track').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.style.opacity = '0.5';
      btn.setAttribute('aria-pressed', 'true');
    });
  });

  // ── Global close on outside click ────────────────────────────────────
  document.addEventListener('click', () => {
    document.querySelectorAll('.badge-pop.open').forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.annot-panel.open').forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.badge[aria-expanded="true"]').forEach(b => b.setAttribute('aria-expanded', 'false'));
    document.querySelectorAll('.annot-block[aria-expanded="true"]').forEach(b => b.setAttribute('aria-expanded', 'false'));
  });

  // ── Parallel strip: reveal once JS is active ─────────────────────────
  document.getElementById('parallel-strip')?.removeAttribute('hidden');
</script>
