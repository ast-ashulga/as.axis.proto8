---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/chrome/Breadcrumb.astro';
import { t, type Locale } from '~/i18n';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);
const navBase = `/${locale}`;
---

<BaseLayout title={tr.parallels_page_heading} locale={locale}>
  <div class="page-body">

    <Breadcrumb locale={locale} crumbs={[
      { label: tr.bc_home, href: `${navBase}/` },
      { label: tr.bc_cross_resonances },
    ]} />

    <!-- Page heading -->
    <header style="margin-bottom: 32px;">
      <h1 style="font: 500 32px/1.2 var(--serif); margin-bottom: 8px;">
        {tr.parallels_page_heading}
      </h1>
      <p style="font: 400 16px/1.7 var(--serif); color: var(--text-2); max-width: var(--col);">
        {tr.parallels_page_intro}
      </p>
      <p style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.08em; color: var(--text-2); margin-top: 12px;">
        {tr.parallels_confirmed_count}
      </p>
    </header>

    <hr class="div" />

    <!-- Parallels list -->
    <section aria-label={tr.parallels_page_heading}>

      <!-- Parallel 1: Flood — documented -->
      <article class="parallel-card" aria-labelledby="par-flood-heading">
        <div class="parallel-card__header">
          <div>
            <h2 id="par-flood-heading" style="font: 500 22px/1.3 var(--serif); margin-bottom: 4px;">
              {tr.parallel_flood_heading}
            </h2>
            <p style="font: 400 13px/1.4 var(--mono); color: var(--text-2); margin-bottom: 12px;">
              {tr.parallel_flood_subtitle_refs}
            </p>
          </div>
          <div class="badge-group">
            <span class="badge badge--doc">{tr.badge_documented}</span>
          </div>
        </div>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px; max-width: var(--col);">
          {tr.parallel_flood_body}
        </p>
        <p style="font: 400 13px/1.4 var(--mono); color: var(--text-2); margin-bottom: 4px;">
          {tr.parallel_flood_trad_lines}
        </p>
        <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 16px;">
          {tr.parallel_flood_onboarded_note}
        </p>
        <p style="font: 400 12px/1.4 var(--mono); color: var(--text-3); margin-bottom: 16px;">
          {tr.parallels_badge_doc_body}
        </p>
        <a
          href={`${navBase}/parallels/flood/`}
          style="font: 500 14px/1.4 var(--serif);"
        >
          {tr.read_this_parallel}
        </a>
      </article>

      <!-- Parallel 2: Grief — reconstructed -->
      <article class="parallel-card" aria-labelledby="par-grief-heading" style="border-left-color: var(--tier-rec);">
        <div class="parallel-card__header">
          <div>
            <h2 id="par-grief-heading" style="font: 500 22px/1.3 var(--serif); margin-bottom: 4px;">
              {tr.parallel_grief_heading}
            </h2>
            <p style="font: 400 13px/1.4 var(--mono); color: var(--text-2); margin-bottom: 12px;">
              {tr.parallel_grief_subtitle_refs}
            </p>
          </div>
          <div class="badge-group">
            <span class="badge badge--rec">{tr.badge_reconstructed}</span>
          </div>
        </div>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px; max-width: var(--col);">
          {tr.parallel_grief_body}
        </p>
        <p style="font: 400 13px/1.4 var(--mono); color: var(--text-2); margin-bottom: 4px;">
          {tr.parallel_grief_trad_lines}
        </p>
        <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 16px;">
          {tr.parallel_grief_onboarded_note}
        </p>
        <p style="font: 400 12px/1.4 var(--mono); color: var(--text-3); margin-bottom: 16px;">
          {tr.parallels_badge_rec_body}
        </p>
        <a
          href={`${navBase}/parallels/grief/`}
          style="font: 500 14px/1.4 var(--serif);"
        >
          {tr.read_this_parallel}
        </a>
      </article>

    </section>

    <hr class="div" />

    <!-- Parallel types -->
    <section aria-labelledby="par-types-heading">
      <h2 id="par-types-heading" style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 20px;">
        {tr.parallel_types_section_heading}
      </h2>
      <div class="type-grid">
        <div class="type-card">
          <h3 style="font: 500 16px/1.4 var(--serif); margin-bottom: 8px;">{tr.parallel_type_card_human_title}</h3>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{tr.parallel_type_card_human_desc}</p>
        </div>
        <div class="type-card">
          <h3 style="font: 500 16px/1.4 var(--serif); margin-bottom: 8px;">{tr.parallel_type_card_narr_title}</h3>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{tr.parallel_type_card_narr_desc}</p>
        </div>
        <div class="type-card">
          <h3 style="font: 500 16px/1.4 var(--serif); margin-bottom: 8px;">{tr.parallel_type_card_social_title}</h3>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{tr.parallel_type_card_social_desc}</p>
        </div>
      </div>
    </section>

    <hr class="div" />

    <!-- About structural resonances -->
    <aside class="about-aside" aria-labelledby="about-res-heading">
      <h2 id="about-res-heading" style="font: 500 16px/1.4 var(--serif); margin-bottom: 12px;">
        {tr.parallels_about_heading}
      </h2>
      <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 12px;">
        {tr.parallels_about_p1}
      </p>
      <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">
        {tr.parallels_about_p2}
      </p>
    </aside>

  </div>
</BaseLayout>

<style>
.page-body {
  padding-inline: var(--mx);
  padding-block: 40px 0;
}

.parallel-card {
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-left: 3px solid var(--tier-doc);
  padding: 28px;
  margin-bottom: 16px;
}

.parallel-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.badge-group { flex-shrink: 0; }

.badge {
  font: 500 11px/1.4 var(--mono);
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border: 1px solid currentColor;
}

.badge--doc { color: var(--tier-doc); }
.badge--rec { color: var(--tier-rec); }

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
  margin-bottom: 40px;
}

.type-card {
  background: var(--surface);
  border: 1px solid var(--border-2);
  padding: 20px;
}

.about-aside {
  background: var(--surface);
  border: 1px solid var(--border-2);
  padding: 24px;
  max-width: var(--col);
  margin-bottom: 40px;
}

@media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
@media (max-width: 767px) {
  .page-body { padding-inline: var(--mx-m); }
  .type-grid { grid-template-columns: 1fr; }
}
</style>
