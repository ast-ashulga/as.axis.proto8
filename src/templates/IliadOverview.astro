---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t, type Locale } from '~/i18n';
import { withBase } from '~/utils/url';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);
const navBase = withBase(`/${locale}`);

const disabledBooks = [
  { label: tr.iliad_book1_label,  name: tr.iliad_book1_name,  desc: tr.iliad_book1_desc,  ep: tr.iliad_book1_ep },
  { label: tr.iliad_book6_label,  name: tr.iliad_book6_name,  desc: tr.iliad_book6_desc,  ep: tr.iliad_book6_ep },
  { label: tr.iliad_book9_label,  name: tr.iliad_book9_name,  desc: tr.iliad_book9_desc,  ep: tr.iliad_book9_ep },
  { label: tr.iliad_book16_label, name: tr.iliad_book16_name, desc: tr.iliad_book16_desc, ep: tr.iliad_book16_ep },
  { label: tr.iliad_book22_label, name: tr.iliad_book22_name, desc: tr.iliad_book22_desc, ep: tr.iliad_book22_ep },
];
---

<BaseLayout title={tr.idx_title_iliad} locale={locale}>
  <div class="page-body">

    <!-- Tradition header -->
    <header style="border-left: 3px solid var(--greek); padding-left: 16px;">
      <p style="font: 500 11px/1.4 var(--mono); letter-spacing: 0.1em; color: var(--greek); margin-bottom: 16px;">
        {tr.tradition_greek}
      </p>
      <h1 style="font: 500 32px/1.2 var(--serif); margin-bottom: 8px;">
        {tr.idx_title_iliad}
      </h1>
      <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 32px;">
        {tr.trad_iliad_epoch_full}
      </p>
    </header>

    <hr class="div" />

    <!-- Description -->
    <div style="max-width: var(--col);">
      <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 20px;">
        {tr.trad_iliad_desc_p1}
      </p>
      <p style="font: 400 16px/1.7 var(--serif);">
        {tr.trad_iliad_desc_p2}
      </p>
    </div>

    <hr class="div" />

    <!-- Cross-tradition resonances -->
    <div style="margin-bottom: 40px; max-width: var(--col);">
      <a href={`${navBase}/parallels/`} style="font: 500 16px/1.7 var(--serif);">
        {tr.cross_tradition_link}
      </a>
      <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-top: 6px;">
        {tr.trad_iliad_cross_tradition_sub}
      </p>
    </div>

    <hr class="div" />

    <!-- Books -->
    <section aria-label={tr.books_label}>
      <p style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 8px;">
        {tr.books_label}
      </p>

      <div class="book-grid" role="list">

        {disabledBooks.map(book => (
          <div
            class="book-card"
            role="group"
            aria-disabled="true"
            style="opacity: 0.55; cursor: default; pointer-events: none;"
          >
            <p style="font: 400 18px/1.4 var(--serif); color: var(--text-2); margin-bottom: 6px;">{book.label}</p>
            <h2 style="font: 500 20px/1.35 var(--serif); margin-bottom: 12px;">{book.name}</h2>
            <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 14px;">{book.desc}</p>
            <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">{book.ep}</p>
            <p style="font: 500 11px/1.4 var(--mono); color: var(--text-dis); margin-top: 8px;">{tr.phase2_badge}</p>
          </div>
        ))}

        <!-- Book XXIV — active -->
        <a
          href={`${navBase}/iliad/book-xxiv/`}
          class="book-card book-card--active"
          role="listitem"
          aria-label={`${tr.iliad_book24_label} — ${tr.iliad_book24_name}`}
          style="border-left: 3px solid var(--tier-rec);"
        >
          <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 6px;">
            <p style="font: 400 18px/1.4 var(--serif); color: var(--text-2);">{tr.iliad_book24_label}</p>
            <span style="font: 500 11px/1.4 var(--mono); color: var(--tier-rec); margin-top: 4px;" aria-hidden="true">[◑]</span>
          </div>
          <h2 style="font: 500 20px/1.35 var(--serif); margin-bottom: 12px;">{tr.iliad_book24_name}</h2>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 14px;">{tr.iliad_book24_desc}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">
            <span style="color: var(--tier-rec);">{tr.iliad_book24_ep_parallel}</span>
            {' · '}
            <span>{tr.iliad_book24_ep_count}</span>
          </p>
        </a>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
.page-body {
  padding-inline: var(--mx);
  padding-block: 40px 0;
}

.book-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 24px;
}

.book-card {
  background: var(--surface);
  border: 1px solid var(--border-2);
  padding: 24px;
  text-decoration: none;
  color: var(--text);
  display: block;
  position: relative;
}

a.book-card--active { transition: background 0.1s ease-in-out; }
a.book-card--active:hover { background: var(--overlay); color: var(--text); }
a.book-card--active:visited { color: var(--text); }

@media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
@media (max-width: 767px) {
  .page-body { padding-inline: var(--mx-m); }
  .book-grid { grid-template-columns: 1fr; }
}
</style>
