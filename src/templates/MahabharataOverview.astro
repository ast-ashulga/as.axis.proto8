---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t, type Locale } from '~/i18n';
import { withBase } from '~/utils/url';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);
const navBase = withBase(`/${locale}`);

const disabledParvas = [
  { label: tr.maha_parva1_label, name: tr.maha_parva1_name, desc: tr.maha_parva1_desc, ep: tr.maha_parva1_ep },
  { label: tr.maha_parva2_label, name: tr.maha_parva2_name, desc: tr.maha_parva2_desc, ep: tr.maha_parva2_ep },
  { label: tr.maha_parva3_label, name: tr.maha_parva3_name, desc: tr.maha_parva3_desc, ep: tr.maha_parva3_ep },
  { label: tr.maha_parva4_label, name: tr.maha_parva4_name, desc: tr.maha_parva4_desc, ep: tr.maha_parva4_ep },
  { label: tr.maha_parva5_label, name: tr.maha_parva5_name, desc: tr.maha_parva5_desc, ep: tr.maha_parva5_ep },
];
---

<BaseLayout title={tr.idx_title_mahabharata} locale={locale}>
  <div class="page-body">

    <!-- Tradition header -->
    <header style="border-left: 3px solid var(--indian); padding-left: 16px;">
      <p style="font: 500 11px/1.4 var(--mono); letter-spacing: 0.1em; color: var(--indian); margin-bottom: 16px;">
        {tr.tradition_indian}
      </p>
      <h1 style="font: 500 32px/1.2 var(--serif); margin-bottom: 8px;">
        {tr.idx_title_mahabharata}
      </h1>
      <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 32px;">
        {tr.trad_mahabharata_epoch_full}
      </p>
    </header>

    <hr class="div" />

    <!-- Description -->
    <div style="max-width: var(--col);">
      <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 20px;">
        {tr.trad_mahabharata_desc_p1}
      </p>
      <p style="font: 400 16px/1.7 var(--serif);">
        {tr.trad_mahabharata_desc_p2}
      </p>
    </div>

    <hr class="div" />

    <!-- Cross-tradition resonances -->
    <div style="margin-bottom: 40px; max-width: var(--col);">
      <a href={`${navBase}/parallels/`} style="font: 500 16px/1.7 var(--serif);" data-track="parallels-index">
        {tr.cross_tradition_link}
      </a>
      <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-top: 6px;">
        {tr.trad_mahabharata_cross_tradition_sub}
      </p>
    </div>

    <hr class="div" />

    <!-- Parvas -->
    <section aria-label={tr.parvas_label}>
      <p style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 8px;">
        {tr.parvas_label}
      </p>

      <div class="parva-grid" role="list">

        {disabledParvas.map(parva => (
          <div
            class="parva-card"
            role="group"
            aria-disabled="true"
            style="opacity: 0.55; cursor: default; pointer-events: none;"
          >
            <p style="font: 400 18px/1.4 var(--serif); color: var(--text-2); margin-bottom: 6px;">{parva.label}</p>
            <h2 style="font: 500 20px/1.35 var(--serif); margin-bottom: 12px;">{parva.name}</h2>
            <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 14px;">{parva.desc}</p>
            <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">{parva.ep}</p>
            <p style="font: 500 11px/1.4 var(--mono); color: var(--text-dis); margin-top: 8px;">{tr.phase2_badge}</p>
          </div>
        ))}

        <!-- Parva VI — Bhishma Parva — active -->
        <a
          href={`${navBase}/mahabharata/book-vi/`}
          class="parva-card parva-card--active"
          role="listitem"
          aria-label={`${tr.maha_parva6_label} — ${tr.maha_parva6_name}`}
          style="border-left: 3px solid var(--tier-rec);"
          data-track="tablet-book-vi-mahabharata"
        >
          <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 6px;">
            <p style="font: 400 18px/1.4 var(--serif); color: var(--text-2);">{tr.maha_parva6_label}</p>
            <span style="font: 500 11px/1.4 var(--mono); color: var(--tier-rec); margin-top: 4px;" aria-hidden="true">[◑]</span>
          </div>
          <h2 style="font: 500 20px/1.35 var(--serif); margin-bottom: 12px;">{tr.maha_parva6_name}</h2>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 14px;">{tr.maha_parva6_desc}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">
            <span style="color: var(--tier-rec);">{tr.maha_parva6_ep_parallel}</span>
            {' · '}
            <span>{tr.maha_parva6_ep_count}</span>
          </p>
        </a>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
.page-body {
  padding-inline: var(--mx);
  padding-block: 40px 0;
}

.parva-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 24px;
}

.parva-card {
  background: var(--surface);
  border: 1px solid var(--border-2);
  padding: 24px;
  text-decoration: none;
  color: var(--text);
  display: block;
  position: relative;
}

a.parva-card--active { transition: background 0.1s ease-in-out; }
a.parva-card--active:hover { background: var(--overlay); color: var(--text); }
a.parva-card--active:visited { color: var(--text); }

@media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
@media (max-width: 767px) {
  .page-body { padding-inline: var(--mx-m); }
  .parva-grid { grid-template-columns: 1fr; }
}
</style>
