  .ai-disclosure { font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border-2); }
  .disc-link { background: none; border: none; cursor: pointer; font: inherit; color: var(--link); text-decoration: underline; text-underline-offset: 2px; padding: 0; }
  .sources-panel { display: none; margin-top: 12px; background: var(--inset); padding: 12px 16px; }
  .sources-panel li { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 4px; list-style: none; }
  .sources-panel li::before { content: "· "; }

  .body-p { font: 400 16px/1.7 var(--serif); margin-bottom: 20px; }
  .body-p:last-of-type { margin-bottom: 0; }

  .demo-marker { font: 400 11px/1.4 var(--mono); color: var(--text-3); padding-bottom: 14px; margin-bottom: 20px; border-bottom: 1px solid var(--border-2); }

  .narr-body p { font: 400 16px/1.7 var(--serif); margin-bottom: 20px; }
  .narr-body p:last-of-type { margin-bottom: 0; }
  .narr-quote { display: block; margin: 20px 0 20px 24px; padding-left: 16px; border-left: 2px solid var(--border); font: italic 16px/1.7 var(--serif); }
  .narr-cite { display: block; font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-top: 6px; font-style: normal; }

  .trans-header { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border-2); }
  .trans-passage { font: 400 16px/1.7 var(--serif); }
  .trans-passage p { margin-bottom: 16px; }
  .trans-passage .verse { margin-inline-start: 20px; margin-bottom: 4px; font-style: italic; }
  .lacuna { font: 400 italic 14px/1.5 var(--serif); color: var(--text-3); margin-block: 12px; display: block; }
  .trans-attribution { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-2); }

  .orig-header { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border-2); }
  .orig-passage { font: 400 13px/1.6 var(--mono); white-space: pre; overflow-x: auto; background: var(--inset); padding: 20px 24px; margin-bottom: 12px; display: block; }
  .orig-attr { font: 400 11px/1.4 var(--mono); color: var(--text-3); }

  .schol-section { margin-bottom: 28px; }
  .schol-section:last-child { margin-bottom: 0; }
  .schol-head { font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; color: var(--text-2); margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-2); display: flex; align-items: center; gap: 12px; }
  .schol-body p { font: 400 16px/1.7 var(--serif); margin-bottom: 14px; }
  .schol-body p:last-child { margin-bottom: 0; }
  .schol-variant { font: 400 14px/1.5 var(--serif); margin-bottom: 10px; padding-inline-start: 16px; border-inline-start: 2px solid var(--border); }
  .schol-cite li { font: 400 14px/1.5 var(--serif); list-style: none; margin-bottom: 6px; color: var(--text-2); }
  .schol-cite li::before { content: "· "; }

  .structure-toggle {
    display: block; background: none; border: none; cursor: pointer;
    font: 400 14px/1.5 var(--serif); color: var(--accent); padding: 0;
    margin-top: 24px; text-decoration: underline; text-underline-offset: 2px;
  }
  .structure-toggle:hover { color: var(--link-h); }

  .track-view {
    display: none; background: var(--inset);
    border: 1px solid var(--border-2); border-top: none;
    padding: 24px 28px;
  }
  .track-view.open { display: block; }
  .track-view-head { font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; color: var(--text-2); margin-bottom: 20px; }
  .track-row { margin-bottom: 24px; }
  .track-row:last-of-type { margin-bottom: 0; }
  .track-label { font: 500 11px/1.4 var(--mono); color: var(--text-2); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .fw-help { background: none; border: 1px solid var(--border); border-radius: 2px; cursor: pointer; font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 1px 5px; }
  .fw-help:hover { color: var(--text); }
  .annot-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .annot-block {
    background: var(--surface); border: 1px solid var(--border-2);
    padding: 10px 12px; cursor: pointer; position: relative; min-width: 120px;
  }
  .annot-block:hover { background: var(--overlay); }
  .annot-block:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .annot-code { font: 500 11px/1.4 var(--mono); color: var(--text); margin-bottom: 3px; }
  .annot-name { font: 400 13px/1.4 var(--serif); color: var(--text-2); margin-bottom: 6px; }
  .annot-panel {
    display: none; position: absolute; top: calc(100% + 4px); left: 0; z-index: 150;
    width: min(320px, calc(100vw - 32px));
    background: var(--surface); border: 1px solid var(--border);
    padding: 14px 16px; font: 400 14px/1.5 var(--serif); color: var(--text);
  }
  .annot-panel.open { display: block; }
  .annot-panel-head { font: 500 11px/1.4 var(--mono); margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border-2); display: flex; justify-content: space-between; }
  .annot-panel-close { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); padding: 0; }
  .annot-panel p { margin-bottom: 8px; }
  .annot-panel .meta-line { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 4px; }
  .fw-explainer { display: none; margin-top: 8px; background: var(--surface); border: 1px solid var(--border-2); padding: 14px 16px; }
  .fw-explainer.open { display: block; }
  .fw-exp-head { font: 500 13px/1.4 var(--mono); margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border-2); display: flex; justify-content: space-between; }
  .fw-exp-close { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); padding: 0; }
  .inactive-tracks { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-2); }
  .add-track { background: none; border: 1px solid var(--border); border-radius: 2px; cursor: pointer; font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 3px 10px; }
  .add-track:hover { color: var(--text); }

  .parallel-strip { border: 1px solid var(--border-2); margin-top: 16px; }
  .parallel-strip-head { background: var(--surface); padding: 14px 20px; border-bottom: 1px solid var(--border-2); }
  .parallel-card { padding: 20px; }
  .parallel-card-title { font: 400 18px/1.4 var(--serif); margin-bottom: 8px; }
  .parallel-card-body { font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 12px; }
  .parallel-card-type { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 14px; }

  .ep-nav { margin-top: 40px; display: flex; justify-content: space-between; align-items: center; padding-top: 24px; border-top: 1px solid var(--border-2); padding-bottom: 8px; }
  .ep-nav a { font: 400 14px/1.5 var(--serif); }

  @media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
  @media (max-width: 767px) {
    .page-body { padding-inline: var(--mx-m); }
    .content-area { padding: 20px 18px; }
    .annot-row { flex-direction: column; }
    .annot-block { min-width: auto; }
    .ep-nav { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
</style>

<script define:vars={{ showStructureLabel: tr.show_structure, hideStructureLabel: tr.hide_structure, seeSources: tr.see_sources, hideSources: tr.hide_sources, nasToCopy: nas, copiedText: tr.copied_confirm, layerPillAria: tr.layer_pill_aria }}>
  const pill = document.createElement('div');
  pill.className = 'layer-pill';
  pill.setAttribute('aria-live', 'polite');
  pill.setAttribute('aria-label', layerPillAria);
  document.body.appendChild(pill);

  const layerIndicator = document.getElementById('layer-indicator');
  if (layerIndicator) {
    new IntersectionObserver(([e]) => {
      pill.classList.toggle('visible', !e.isIntersecting);
    }, { threshold: 0 }).observe(layerIndicator);
  }

  function updatePill(labelEl) {
    const plain = labelEl?.querySelector('.layer-tab__plain');
    if (plain) pill.textContent = plain.textContent ?? '';
  }
  updatePill(document.querySelector('.layer-tab[aria-selected="true"]'));

  document.querySelectorAll('.layer-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const layer = tab.dataset.layer;
      document.querySelectorAll('.layer-tab').forEach(t => t.setAttribute('aria-selected', 'false'));
      document.querySelectorAll('.layer-panel').forEach(p => p.classList.remove('active'));
      tab.setAttribute('aria-selected', 'true');
      const panel = document.getElementById('layer-' + layer);
      if (panel) panel.classList.add('active');
      updatePill(tab);
    });
  });

  const copyBtn = document.getElementById('nas-copy-btn');
  const copiedEl = document.getElementById('copied-confirm');
  if (copyBtn && copiedEl) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(nasToCopy).then(() => {
        copiedEl.style.display = 'inline';
        setTimeout(() => { copiedEl.style.display = 'none'; }, 2000);
      });
    });
  }

  const seeSrcBtn = document.getElementById('see-sources-btn');
  const sourcesPanel = document.getElementById('sources-panel');
  if (seeSrcBtn && sourcesPanel) {
    seeSrcBtn.addEventListener('click', () => {
      const open = sourcesPanel.style.display === 'block';
      sourcesPanel.style.display = open ? 'none' : 'block';
      seeSrcBtn.setAttribute('aria-expanded', String(!open));
      seeSrcBtn.textContent = open ? seeSources : hideSources;
    });
  }

  const structureToggle = document.getElementById('structure-toggle');
  const trackView = document.getElementById('track-view');
  if (structureToggle && trackView) {
    structureToggle.addEventListener('click', () => {
      const open = trackView.classList.contains('open');
      trackView.classList.toggle('open', !open);
      trackView.hidden = open;
      trackView.setAttribute('aria-hidden', String(open));
      structureToggle.setAttribute('aria-expanded', String(!open));
      structureToggle.textContent = open ? showStructureLabel : hideStructureLabel;
    });
  }

  document.querySelectorAll('.badge').forEach(badge => {
    const pop = badge.querySelector('.badge-pop');
    if (!pop) return;
    badge.addEventListener('click', e => {
      e.stopPropagation();
      const open = pop.classList.contains('open');
      document.querySelectorAll('.badge-pop').forEach(p => p.classList.remove('open'));
      if (!open) pop.classList.add('open');
      badge.setAttribute('aria-expanded', String(!open));
    });
    const closeBtn = pop.querySelector('.pop-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', e => {
        e.stopPropagation();
        pop.classList.remove('open');
        badge.setAttribute('aria-expanded', 'false');
      });
    }
  });

  document.querySelectorAll('.annot-block').forEach(block => {
    const panel = block.querySelector('.annot-panel');
    if (!panel) return;
    block.addEventListener('click', e => {
      e.stopPropagation();
      const open = panel.classList.contains('open');
      document.querySelectorAll('.annot-panel').forEach(p => p.classList.remove('open'));
      document.querySelectorAll('.annot-block').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!open) { panel.classList.add('open'); block.setAttribute('aria-expanded', 'true'); }
    });
    block.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); block.click(); }
    });
    const closeBtn = panel.querySelector('.annot-panel-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', e => {
        e.stopPropagation();
        panel.classList.remove('open');
        block.setAttribute('aria-expanded', 'false');
      });
    }
  });

  document.querySelectorAll('.fw-help').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.explainer;
      const exp = id ? document.getElementById(id) : null;
      if (exp) exp.classList.toggle('open');
    });
  });
  document.querySelectorAll('.fw-exp-close').forEach(btn => {
    btn.addEventListener('click', () => { btn.closest('.fw-explainer')?.classList.remove('open'); });
  });

  document.querySelectorAll('.add-track').forEach(btn => {
    btn.addEventListener('click', () => { btn.style.opacity = '0.5'; btn.setAttribute('aria-pressed', 'true'); });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.badge-pop.open').forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.annot-panel.open').forEach(p => p.classList.remove('open'));
    document.querySelectorAll('.badge[aria-expanded="true"]').forEach(b => b.setAttribute('aria-expanded', 'false'));
    document.querySelectorAll('.annot-block[aria-expanded="true"]').forEach(b => b.setAttribute('aria-expanded', 'false'));
  });

  document.getElementById('parallel-strip')?.removeAttribute('hidden');
</script>
