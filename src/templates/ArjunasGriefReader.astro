  .layer-tab { background: none; border: none; cursor: pointer; font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 4px 0; display: flex; flex-direction: column; align-items: flex-start; gap: 1px; }
  .layer-tab__plain { font: 500 12px/1.3 var(--mono); }
  .layer-tab__poetic { font: 400 10px/1.3 var(--mono); color: var(--text-3); }
  .layer-tab[aria-selected="true"] .layer-tab__plain { color: var(--text); }
  .layer-tab[aria-selected="true"] .layer-tab__poetic { color: var(--text-2); }
  .layer-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .layer-sep { font: 400 11px/1.4 var(--mono); color: var(--text-3); padding: 0 12px; user-select: none; align-self: center; }

  .content-area { border: 1px solid var(--border-2); background: var(--surface); padding: 32px 36px; }
