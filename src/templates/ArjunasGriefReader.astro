---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/chrome/Breadcrumb.astro';
import HowToReadThisPage from '~/components/HowToReadThisPage.astro';
import TraditionDivider from '~/components/TraditionDivider.astro';
import DropCap from '~/components/DropCap.astro';
import NarrativeMap from '~/components/visualizations/NarrativeMap.astro';
import ProppMorphology from '~/components/visualizations/ProppMorphology.astro';
import MotifTagCloud from '~/components/visualizations/MotifTagCloud.astro';
import NextBestAction from '~/components/reader/NextBestAction.astro';
import { t, type Locale } from '~/i18n';
import { arjunasGriefReaderExtras } from '~/i18n/readers/mahabharataReaders';
import { withBase } from '~/utils/url';
import { getEntry } from 'astro:content';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);
const rc = arjunasGriefReaderExtras(locale);

const nas = 'nms://mahabharata/book-vi/arjunas-grief';
const parallelHref = withBase(`/${locale}/parallels/hero-crisis/`);
const nextHref = withBase(`/${locale}/mahabharata/book-vi/krishna-counsel/`);
const bookHref = withBase(`/${locale}/mahabharata/book-vi/`);
const mahabharataHref = withBase(`/${locale}/mahabharata/`);

const episode = await getEntry('episodes', 'mahabharata-arjunas-grief');
const proppFunctions = episode?.data.proppFunctions;

const tmiMotifs = episode?.data.tmiMotifs;
---

<BaseLayout title={tr.frag_arjunas_grief_title + tr.doc_title_suffix_book_vi_mahabharata} locale={locale}>

  <div class="page-body">

    <!-- Breadcrumb -->
    <Breadcrumb locale={locale} crumbs={[
      { label: tr.bc_home,                  href: withBase(`/${locale}/`) },
      { label: tr.nav_mahabharata,           href: mahabharataHref },
      { label: tr.maha_book_vi_hub_breadcrumb, href: bookHref },
      { label: tr.frag_arjunas_grief_title },
    ]} />

    <!-- NAS row -->
    <div class="nas-row" role="status" aria-live="polite">
      <span class="nas-addr" aria-label={`${tr.nas_address_aria_prefix}${nas}`}>{nas}</span>
      <button class="nas-copy" id="nas-copy-btn" aria-label={tr.copy_nas_aria}>
        {tr.copy_btn}
      </button>
      <span class="copied-confirm" id="copied-confirm" role="status" aria-live="polite">
        {tr.copied_confirm}
      </span>
    </div>

    <TraditionDivider tradition="indian" />

    <!-- Episode heading -->
    <div class="ep-heading">
      <h1 class="ep-title">{tr.frag_arjunas_grief_title}</h1>
      <button class="badge ins" id="episode-badge" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_ai_reviewed}`} aria-expanded="false">
        <span>{tr.badge_ai_reviewed}</span>
        <div class="badge-pop" id="episode-badge-pop">
          <div class="pop-head">
            <span>{tr.badge_ai_reviewed}</span>
            <button type="button" class="pop-close">{tr.close_x}</button>
          </div>
          <p>{tr.frag_badge_ai_pop_p1}</p>
          <p>{tr.frag_arjunas_grief_badge_ai_pop_p2}</p>
          <ul>
            <li>{nas}{tr.frag_nas_tag_doc}</li>
          </ul>
        </div>
      </button>
    </div>
    <p class="ep-sub">{tr.frag_arjunas_grief_subtitle}</p>

    <HowToReadThisPage locale={locale} />

    <!-- Layer indicator -->
    <div class="layer-indicator" role="tablist" id="layer-indicator" aria-label={tr.layer_depth_tablist_aria}>
      <button class="layer-tab" role="tab" id="tab-surface" aria-selected="true" aria-controls="layer-surface" data-layer="surface" data-track="layer-surface">
        <span class="layer-tab__plain">{tr.layer_surface_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_surface_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-narrated" aria-selected="false" aria-controls="layer-narrated" data-layer="narrated" data-track="layer-narrated">
        <span class="layer-tab__plain">{tr.layer_narrated_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_narrated_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-translated" aria-selected="false" aria-controls="layer-translated" data-layer="translated" data-track="layer-translated">
        <span class="layer-tab__plain">{tr.layer_translated_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_translated_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-original" aria-selected="false" aria-controls="layer-original" data-layer="original" data-track="layer-original">
        <span class="layer-tab__plain">{tr.layer_original_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_original_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-scholaria" aria-selected="false" aria-controls="layer-scholaria" data-layer="scholaria" data-track="layer-scholaria">
        <span class="layer-tab__plain">{tr.layer_scholaria_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_scholaria_poetic}</span>
      </button>
    </div>

    <!-- Content area -->
    <div class="content-area" id="content-area" tabindex="-1">

      <!-- ─── SURFACE LAYER ─── -->
      <div id="layer-surface" class="layer-panel active" role="tabpanel" aria-labelledby="tab-surface">
        <NarrativeMap episode="arjunas-grief" locale={locale} tradition="indian" />
        <div class="ai-disclosure" role="note">
          <span>{tr.frag_arjunas_grief_ai_disclosure_lead}&nbsp;</span>
          <button type="button" class="disc-link" id="see-sources-btn" aria-expanded="false" aria-controls="sources-panel">
            {tr.see_sources}
          </button>
          <div class="sources-panel" id="sources-panel" role="region" aria-label={tr.sources_region_label}>
            <ul>
              <li>{nas}{tr.frag_nas_tag_doc}</li>
            </ul>
          </div>
        </div>
        <DropCap tradition="indian">{tr.frag_surf_arjunas_grief_p1}</DropCap>
        <p class="body-p">{tr.frag_surf_arjunas_grief_p2}</p>
        <p class="body-p">{tr.frag_surf_arjunas_grief_p3}</p>
        <p class="body-p">{tr.frag_surf_arjunas_grief_p4}</p>
      </div>

      <!-- ─── NARRATED LAYER ─── -->
      <div id="layer-narrated" class="layer-panel" role="tabpanel" aria-labelledby="tab-narrated">
        <p class="demo-marker">{tr.demo_content_marker}</p>
        <div class="narr-body">
          <p>{rc.narrP1}</p>
          <p>{rc.narrP2}</p>
          <blockquote class="narr-quote">
            <span set:html={rc.narrQuoteArjunaHtml} />
            <cite class="narr-cite">{rc.narrQuoteArjunaCite}</cite>
          </blockquote>
          <p>{rc.narrP3}</p>
        </div>
      </div>

      <!-- ─── TRANSLATED LAYER ─── -->
      <div id="layer-translated" class="layer-panel" role="tabpanel" aria-labelledby="tab-translated">
        <div class="trans-header">
          <p style="font: 400 16px/1.5 var(--serif); margin-bottom: 4px;">Translation: Annie Besant & Bhagavan Das (1905)</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 2px;">Source: Besant & Das, <em>The Bhagavad-Gita</em> (1905) · Public domain</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">Bhishma Parva, Chapter 1 (selected verses)</p>
        </div>
        <div class="trans-passage" lang={locale === 'ru' ? 'ru' : 'en'}>
          {rc.transSegments.map((seg) =>
            seg.kind === 'lacuna' ? (
              <span class="lacuna" role="note" aria-label={seg.aria} set:html={seg.text} />
            ) : seg.kind === 'verse' ? (
              <p class="verse">{seg.text}</p>
            ) : (
              <p>{seg.text}</p>
            )
          )}
          <p class="trans-attribution">{rc.transAttribution}</p>
        </div>
      </div>

      <!-- ─── ORIGINAL LAYER ─── -->
      <div id="layer-original" class="layer-panel" role="tabpanel" aria-labelledby="tab-original">
        <p class="demo-marker">{tr.demo_content_marker}</p>
        <div class="orig-header">
          <p style="font: 400 16px/1.5 var(--serif); margin-bottom: 4px;">{rc.origHeadMain}</p>
          <p class="orig-attr">{rc.origAttrArnold}</p>
        </div>
        <pre class="orig-passage" lang="sa" dir="ltr">BG 1.28  dṛṣṭvemāṃ svajanaṃ kṛṣṇa yuyutsuṃ samupasthitam
BG 1.29  sīdanti mama gātrāṇi mukhaṃ ca pariśuṣyati
         vepathuś ca śarīre me romaharṣaś ca jāyate

BG 1.30  gāṇḍīvaṃ sraṃsate hastāt tvak caiva paridahyate
         na ca śaknomy avasthātuṃ bhramatīva ca me manaḥ

BG 1.36  pāpam evāśrayed asmān hatvaitān ātatāyinaḥ
         tasmān nārhā vayaṃ hantuṃ dhārtarāṣṭrān svabāndhavān
         svajanaṃ hi kathaṃ hatvā sukhinaḥ syāma mādhava

BG 1.47  evam uktvārjunaḥ saṃkhye rathopastha upāviśat
         visṛjya saśaraṃ cāpaṃ śokasaṃvignamānasaḥ</pre>
        <p class="orig-attr">{rc.origDemoNote}</p>
      </div>

      <!-- ─── SCHOLARIA LAYER ─── -->
      <div id="layer-scholaria" class="layer-panel" role="tabpanel" aria-labelledby="tab-scholaria">

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.schol_manuscript_status}</span>
            <button class="badge doc" style="cursor: default;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_documented}`}>{tr.badge_documented}</button>
          </div>
          <div class="schol-body">
            <p>{rc.scholMs}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.schol_textual_history}</span>
            <button class="badge rec" style="cursor: default;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_reconstructed}`}>{tr.badge_reconstructed}</button>
          </div>
          <div class="schol-body">
            <p>{rc.scholHist}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{rc.scholDebateHead}</span>
            <button class="badge con" style="cursor: default;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_contested}`}>{tr.badge_contested}</button>
          </div>
          <div class="schol-body">
            <p>{rc.scholDebateP}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_key_variants}</span></div>
          <div class="schol-body">
            <div class="schol-variant">
              <p>{rc.scholVariantGita}</p>
              <p style="margin-top: 6px;"><button class="badge con" style="cursor: default; font-size: 10px;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_contested}`}>{tr.badge_contested}</button></p>
            </div>
            <div class="schol-variant">
              <p>{rc.scholVariantChap}</p>
              <p style="margin-top: 6px;"><button class="badge rec" style="cursor: default; font-size: 10px;" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_reconstructed}`}>{tr.badge_reconstructed}</button></p>
            </div>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_visualization_tools}</span></div>
          <div class="schol-body">
            <ProppMorphology functions={proppFunctions} locale={locale} />
            <MotifTagCloud motifs={tmiMotifs} locale={locale} />
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_scholarship_cited}</span></div>
          <ul class="schol-cite">
            <li><span set:html={rc.scholCite1_html} /></li>
            <li><span set:html={rc.scholCite2_html} /></li>
            <li><span set:html={rc.scholCite3_html} /></li>
          </ul>
        </div>

      </div>

      <!-- Structure toggle -->
      <button type="button" class="structure-toggle" id="structure-toggle" aria-expanded="false" aria-controls="track-view">
        {tr.show_structure}
      </button>

    </div><!-- /content-area -->

    <!-- Track View -->
    <div class="track-view" id="track-view" role="region" aria-label={tr.track_region_aria} hidden aria-hidden="true">
      <p class="track-view-head">{tr.track_head_book_vi_arjunas_grief}</p>

      <!-- Propp -->
      <div class="track-row">
        <div class="track-label">
          {tr.track_framework_label_propp}
          <button class="fw-help" aria-label={tr.help_propp_morphology_aria} data-explainer="exp-propp">[?]</button>
        </div>
        <div class="fw-explainer" id="exp-propp">
          <div class="fw-exp-head">{rc.proppFwTitle} <button class="fw-exp-close">{tr.close_x}</button></div>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{rc.proppFwBody}</p>
        </div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_propp_aria}>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-8: ${rc.propp8Name}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">PROPP-8</p>
            <p class="annot-name">{rc.propp8Name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.propp8PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.propp8PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
              <p class="meta-line">{tr.meta_nas_colon} {nas}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-10: ${rc.propp10Name}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">PROPP-10</p>
            <p class="annot-name">{rc.propp10Name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.propp10PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.propp10PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-12: ${rc.propp12Name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">PROPP-12</p>
            <p class="annot-name">{rc.propp12Name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.propp12PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.propp12PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Campbell -->
      <div class="track-row">
        <div class="track-label">
          {tr.track_framework_label_campbell}
          <button class="fw-help" aria-label={tr.help_campbell_hero_aria} data-explainer="exp-campbell">[?]</button>
        </div>
        <div class="fw-explainer" id="exp-campbell">
          <div class="fw-exp-head">{rc.campFwTitle} <button class="fw-exp-close">{tr.close_x}</button></div>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{rc.campFwBody}</p>
        </div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_campbell_aria}>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`${rc.campRefusalName}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">CAMPBELL</p>
            <p class="annot-name">{rc.campRefusalName}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.campRefusalPanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.campRefusalPanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`${rc.campMentorName}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">CAMPBELL</p>
            <p class="annot-name">{rc.campMentorName}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.campMentorPanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.campMentorPanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- TMI -->
      <div class="track-row">
        <div class="track-label">
          {tr.track_label_tmi_paren}
          <button class="fw-help" aria-label={tr.help_thompson_motif_aria} data-explainer="exp-tmi">[?]</button>
        </div>
        <div class="fw-explainer" id="exp-tmi">
          <div class="fw-exp-head">{rc.tmiFwTitle} <button class="fw-exp-close">{tr.close_x}</button></div>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{rc.tmiFwBody}</p>
        </div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_tmi_aria}>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`P14.6: ${rc.tmiP146Name}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">P14.6</p>
            <p class="annot-name">{rc.tmiP146Name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.tmiP146PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.tmiP146PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
            </div>
          </div>
          <div class="annot-block" role="button" aria-expanded="false" aria-label={`H580: ${rc.tmiH580Name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">H580</p>
            <p class="annot-name">{rc.tmiH580Name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.badge_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{rc.tmiH580PanelHead} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{rc.tmiH580PanelP}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_sharma}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Inactive tracks -->
      <div class="inactive-tracks">
        <button class="add-track" aria-pressed="false">{tr.inactive_track_bakhtin}</button>
        <button class="add-track" aria-pressed="false">{tr.inactive_track_levi_strauss}</button>
        <button class="add-track" aria-pressed="false">{tr.inactive_track_emotional_valence}</button>
      </div>
    </div><!-- /track-view -->

    <!-- Parallel strip -->
    <div class="parallel-strip" id="parallel-strip" role="complementary" aria-label={tr.parallel_strip_region_aria} hidden>
      <div class="parallel-strip-head">
        <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2);">{tr.parallel_strip_heading}</p>
      </div>
      <div class="parallel-card">
        <p style="margin-bottom: 10px;">
          <button class="badge rec" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_reconstructed}`} aria-expanded="false">
            <span>{tr.badge_reconstructed}</span>
            <div class="badge-pop">
              <div class="pop-head"><span>{tr.badge_reconstructed}</span> <button type="button" class="pop-close">{tr.close_x}</button></div>
              <p>{tr.parallels_badge_rec_body}</p>
            </div>
          </button>
        </p>
        <h2 class="parallel-card-title">
          {tr.reader_parallel_card_hero_crisis_title}&nbsp;·&nbsp;<span style="font-weight: 400; color: var(--text-2);">{tr.reader_parallel_card_hero_crisis_subtitle}</span>
        </h2>
        <p class="parallel-card-body">{tr.parallel_hero_crisis_reader_body}</p>
        <p class="parallel-card-type">{tr.parallel_type_structural}</p>
        <a href={parallelHref} aria-label={tr.parallel_read_hero_crisis_aria} style="font: 500 16px/1.7 var(--serif);" data-track="parallel-hero-crisis">
          {tr.read_this_parallel}
        </a>
      </div>
    </div>

    <NextBestAction
      locale={locale}
      deeper={{ href: '#tab-scholaria', label: tr.next_action_deeper_label, desc: tr.next_action_deeper_desc_arjunas_grief }}
      parallel={{ href: parallelHref, label: tr.next_action_parallel_label, desc: tr.parallel_hero_crisis_heading }}
      next={{ href: nextHref, label: tr.next_action_next_ep_label, desc: tr.frag_krishna_counsel_title }}
    />

    <!-- Episode navigation -->
    <nav class="ep-nav" aria-label={tr.ep_nav_adjacent_aria}>
      <a href={bookHref} rel="prev" aria-label={tr.ep_nav_prev_aria}>{tr.frag_nav_arjunas_grief_hub}</a>
      <a href={nextHref} rel="next" aria-label={tr.ep_nav_next_aria}>{tr.frag_nav_arjunas_grief_next}</a>
    </nav>

  </div><!-- /page-body -->

</BaseLayout>

<style>
  .page-body {
    padding-inline: var(--mx);
    padding-block: 40px 0;
    max-width: calc(var(--col) + var(--mx) * 2);
    margin-inline: auto;
