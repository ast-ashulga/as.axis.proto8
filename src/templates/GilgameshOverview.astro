---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t, type Locale } from '~/i18n';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);
const navBase = `/${locale}`;

const disabledTablets = [
  { label: tr.trad_tablet1_label, name: tr.trad_tablet1_name, desc: tr.trad_tablet1_desc, ep: tr.trad_tablet1_ep },
  { label: tr.trad_tablet2_label, name: tr.trad_tablet2_name, desc: tr.trad_tablet2_desc, ep: tr.trad_tablet2_ep },
  { label: tr.trad_tablet3_label, name: tr.trad_tablet3_name, desc: tr.trad_tablet3_desc, ep: tr.trad_tablet3_ep },
  { label: tr.trad_tablet4_label, name: tr.trad_tablet4_name, desc: tr.trad_tablet4_desc, ep: tr.trad_tablet4_ep },
  { label: tr.trad_tablet5_label, name: tr.trad_tablet5_name, desc: tr.trad_tablet5_desc, ep: tr.trad_tablet5_ep },
];
---

<BaseLayout title={tr.idx_title_gilgamesh} locale={locale}>
  <div class="page-body">

    <!-- Tradition header -->
    <header style="border-left: 3px solid var(--mesop); padding-left: 16px;">
      <p style="font: 500 11px/1.4 var(--mono); letter-spacing: 0.1em; color: var(--mesop); margin-bottom: 16px;">
        {tr.tradition_mesopotamian}
      </p>
      <h1 style="font: 500 32px/1.2 var(--serif); margin-bottom: 8px;">
        {tr.idx_title_gilgamesh}
      </h1>
      <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 32px;">
        {tr.trad_gilgamesh_epoch_full}
      </p>
    </header>

    <hr class="div" />

    <!-- Description -->
    <div style="max-width: var(--col);">
      <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 20px;">
        {tr.trad_gilgamesh_desc_p1}
      </p>
      <p style="font: 400 16px/1.7 var(--serif);">
        {tr.trad_gilgamesh_desc_p2}
      </p>
    </div>

    <hr class="div" />

    <!-- Cross-tradition resonances -->
    <div style="margin-bottom: 40px; max-width: var(--col);">
      <a href={`${navBase}/parallels/`} style="font: 500 16px/1.7 var(--serif);">
        {tr.cross_tradition_link}
      </a>
      <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-top: 6px;">
        {tr.trad_cross_tradition_sub}
      </p>
    </div>

    <hr class="div" />

    <!-- Tablets -->
    <section aria-label={tr.tablets_label}>
      <p style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 8px;">
        {tr.tablets_label}
      </p>

      <div class="tablet-grid" role="list">

        {disabledTablets.map(tab => (
          <div
            class="tablet-card"
            role="group"
            aria-disabled="true"
            style="opacity: 0.55; cursor: default; pointer-events: none;"
          >
            <p style="font: 400 18px/1.4 var(--serif); color: var(--text-2); margin-bottom: 6px;">{tab.label}</p>
            <h2 style="font: 500 20px/1.35 var(--serif); margin-bottom: 12px;">{tab.name}</h2>
            <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 14px;">{tab.desc}</p>
            <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">{tab.ep}</p>
            <p style="font: 500 11px/1.4 var(--mono); color: var(--text-dis); margin-top: 8px;">{tr.phase2_badge}</p>
          </div>
        ))}

        <!-- Tablet XI — active -->
        <a
          href={`${navBase}/gilgamesh/tablet-xi/`}
          class="tablet-card tablet-card--active"
          role="listitem"
          aria-label={`${tr.trad_tablet11_label} — ${tr.trad_tablet11_name}`}
          style="border-left: 3px solid var(--tier-doc);"
        >
          <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 6px;">
            <p style="font: 400 18px/1.4 var(--serif); color: var(--text-2);">{tr.trad_tablet11_label}</p>
            <span style="font: 500 11px/1.4 var(--mono); color: var(--tier-doc); margin-top: 4px;" aria-hidden="true">[●]</span>
          </div>
          <h2 style="font: 500 20px/1.35 var(--serif); margin-bottom: 12px;">{tr.trad_tablet11_name}</h2>
          <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 14px;">{tr.trad_tablet11_desc}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">
            <span style="color: var(--tier-doc);">{tr.trad_tablet11_ep_parallel}</span>
            {' · '}
            <span>{tr.trad_tablet11_ep_count}</span>
          </p>
        </a>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
.page-body {
  padding-inline: var(--mx);
  padding-block: 40px 0;
}

.tablet-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 24px;
}

.tablet-card {
  background: var(--surface);
  border: 1px solid var(--border-2);
  padding: 24px;
  text-decoration: none;
  color: var(--text);
  display: block;
  position: relative;
}

a.tablet-card--active { transition: background 0.1s ease-in-out; }
a.tablet-card--active:hover { background: var(--overlay); color: var(--text); }
a.tablet-card--active:visited { color: var(--text); }

@media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
@media (max-width: 767px) {
  .page-body { padding-inline: var(--mx-m); }
  .tablet-grid { grid-template-columns: 1fr; }
}
</style>
