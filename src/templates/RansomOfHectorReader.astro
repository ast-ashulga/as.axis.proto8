---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/chrome/Breadcrumb.astro';
import HowToReadThisPage from '~/components/HowToReadThisPage.astro';
import TraditionDivider from '~/components/TraditionDivider.astro';
import DropCap from '~/components/DropCap.astro';
import { t, type Locale } from '~/i18n';
import { withBase } from '~/utils/url';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);

const nas = 'nms://iliad/book-xxiv/ransom-of-hector';
const prevHref = withBase(`/${locale}/iliad/book-xxiv/`);
const nextHref = withBase(`/${locale}/iliad/book-xxiv/`);
const bookHref = withBase(`/${locale}/iliad/book-xxiv/`);
---

<BaseLayout title={tr.iliad_frag_ransom_title + tr.doc_title_suffix_book_xxiv_iliad} locale={locale}>
  <div class="page-body">

    <Breadcrumb locale={locale} crumbs={[
      { label: tr.bc_home,                href: withBase(`/${locale}/`) },
      { label: tr.idx_title_iliad,        href: withBase(`/${locale}/iliad/`) },
      { label: tr.iliad_frag_book24_bc,   href: bookHref },
      { label: tr.iliad_frag_ransom_crumb },
    ]} />

    <div class="nas-row">
      <span class="nas-addr" aria-label={`${tr.nas_address_aria_prefix}${nas}`}>{nas}</span>
      <button class="nas-copy" id="nas-copy-btn" aria-label={tr.copy_nas_aria}>{tr.copy_btn}</button>
      <span class="copied-confirm" id="copied-confirm">{tr.copied_confirm}</span>
    </div>

    <TraditionDivider tradition="greek" />

    <div class="ep-heading">
      <h1 class="ep-title">{tr.iliad_frag_ransom_title}</h1>
      <button class="badge ins" id="episode-badge" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_ai_reviewed}`} aria-expanded="false">
        <span>{tr.badge_ai_reviewed}</span>
        <div class="badge-pop" id="episode-badge-pop">
          <div class="pop-head"><span>{tr.badge_ai_reviewed}</span><button type="button" class="pop-close">{tr.close_x}</button></div>
          <p>{tr.frag_badge_ai_pop_p1}</p>
          <p>{tr.iliad_frag_badge_ai_pop_p2}</p>
          <ul><li>{nas}</li></ul>
        </div>
      </button>
    </div>
    <p class="ep-sub">{tr.iliad_frag_ransom_subtitle}</p>
    <p class="ai-lead">{tr.iliad_frag_ai_disclosure_lead}</p>

    <HowToReadThisPage locale={locale} />

    <div class="layer-indicator" role="tablist" aria-label={tr.layer_depth_tablist_aria}>
      <button class="layer-tab" role="tab" id="tab-surface" aria-selected="true" aria-controls="layer-surface" data-layer="surface">
        <span class="layer-tab__plain">{tr.layer_surface_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_surface_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-narrated" aria-selected="false" aria-controls="layer-narrated" data-layer="narrated">
        <span class="layer-tab__plain">{tr.layer_narrated_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_narrated_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-translated" aria-selected="false" aria-controls="layer-translated" data-layer="translated">
        <span class="layer-tab__plain">{tr.layer_translated_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_translated_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-original" aria-selected="false" aria-controls="layer-original" data-layer="original">
        <span class="layer-tab__plain">{tr.layer_original_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_original_poetic}</span>
      </button>
      <span class="layer-sep" aria-hidden="true">·</span>
      <button class="layer-tab" role="tab" id="tab-scholaria" aria-selected="false" aria-controls="layer-scholaria" data-layer="scholaria">
        <span class="layer-tab__plain">{tr.layer_scholaria_plain}</span>
        <span class="layer-tab__poetic">{tr.layer_scholaria_poetic}</span>
      </button>
    </div>

    <div class="content-area" id="content-area" tabindex="-1">

      <!-- Surface layer -->
      <div id="layer-surface" class="layer-panel active" role="tabpanel" aria-labelledby="tab-surface">
        <div class="ai-disclosure" role="note">
          <span>{tr.iliad_frag_ai_disclosure_lead}&nbsp;</span>
          <button type="button" class="disc-link" id="see-sources-btn" aria-expanded="false" aria-controls="sources-panel">{tr.see_sources}</button>
          <div class="sources-panel" id="sources-panel" role="region" aria-label={tr.sources_region_label}>
            <ul><li>{nas}</li></ul>
          </div>
        </div>
        <DropCap tradition="greek">{tr.iliad_frag_ransom_surf_p1}</DropCap>
        <p class="body-p">{tr.iliad_frag_ransom_surf_p2}</p>
        <p class="body-p">{tr.iliad_frag_ransom_surf_p3}</p>
        <p class="body-p">{tr.iliad_frag_ransom_surf_p4}</p>

        <!-- Parallel strip (hidden by default; JS reveals after load) -->
        <aside class="parallel-strip" id="parallel-strip" aria-label={tr.parallel_strip_region_aria} hidden>
          <p class="par-strip-head">{tr.parallel_strip_heading}</p>
          <div class="par-card">
            <p style="font: 500 14px/1.4 var(--serif); margin-bottom: 6px; color: var(--tier-rec);">◑</p>
            <p class="par-card-body">{tr.iliad_frag_parallel_card_body}</p>
            <a href={withBase(`/${locale}/parallels/grief/`)} class="par-read-link">{tr.read_this_parallel}</a>
          </div>
        </aside>
      </div>

      <!-- Narrated layer -->
      <div id="layer-narrated" class="layer-panel" role="tabpanel" aria-labelledby="tab-narrated">
        <div class="layer-demo-banner">
          <button class="badge ins" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_ai_reviewed}`} style="cursor: default; pointer-events: none;">
            <span>{tr.badge_ai_reviewed}</span>
          </button>
          <span style="font: 400 12px/1.4 var(--mono); color: var(--text-3); margin-left: 8px;">{tr.demo_content_marker}</span>
        </div>
        <p class="body-p">Book XXIV is the moral culmination of the Iliad. Everything the poem has built toward — Achilles' wrath, Patroclus' death, Hector's fall, the continued defilement of the body — converges in a single hut, at night, between two men who are enemies.</p>
        <p class="body-p">Priam's arrival is staged as a miracle. He is an old man who has crossed enemy lines alone. He has kissed the hands of the man who killed his son. Homer presents this without sentimentality: the gesture is precise, appalling, and it works. Achilles is moved. What moves him is recognition — he sees in Priam's grief the grief of his own father Peleus, who will not see his son return either. The mourning is parallel, not identical. Each man weeps for his own dead.</p>
        <blockquote class="narr-quote">
          <p>"So spake he, and stirred in Achilles desire to make lament for his father; and he touched the old man's hand and gently put him from him. And the twain bethought them of their dead and wept."</p>
          <cite>— Lang, Leaf &amp; Myers (1882), Book XXIV, ll. 507–511</cite>
        </blockquote>
        <p class="body-p">The scene has attracted more scholarly attention than almost any other in the poem, because it does something the war logic cannot account for: it makes grief transferable across the enemy line. Achilles does not forgive Priam — there is nothing to forgive. He recognizes him. The distinction matters for what the poem argues about heroic identity and its limits.</p>
      </div>

      <!-- Translated layer -->
      <div id="layer-translated" class="layer-panel" role="tabpanel" aria-labelledby="tab-translated">
        <div class="trans-header">
          <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div>
              <p style="font: 400 16px/1.5 var(--serif); margin-bottom: 4px;">Translation: Andrew Lang, Walter Leaf, and Ernest Myers (1882)</p>
              <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">Source: Lang, Leaf &amp; Myers, <em>The Iliad of Homer</em> (1882) · Public domain</p>
            </div>
            <button class="badge doc" aria-label={`${tr.tier_button_aria_prefix}${tr.badge_documented}`} aria-expanded="false">
              <span>{tr.badge_documented}</span>
              <div class="badge-pop">
                <div class="pop-head"><span>{tr.badge_documented}</span><button type="button" class="pop-close">{tr.close_x}</button></div>
                <p>{tr.iliad_frag_badge_trans_pop_p1}</p>
              </div>
            </button>
          </div>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-top: 8px;">Book XXIV, lines 477–551 (selected)</p>
        </div>
        <div class="trans-passage" lang="en">
          <p>Priam the old man passed within the house and found Achilles, dear to Zeus, sitting apart, and the heroes were seated apart. And two alone, Automedon and Alkimos, of the stock of Ares, were busy in attendance; for Achilles had but newly ceased from meat and drink, and the table was still standing by him.</p>
          <p>And great Priam entered unnoticed, and stood near, and clasped the knees of Achilles, and kissed his terrible man-slaying hands that had slain so many of Priam's sons.</p>
          <p>And as when a mighty woe cometh upon a man who in his own country hath slain another, and he cometh to the land of strangers, to a rich man's house, and wonder holdeth them that see him — so Achilles wondered when he saw godlike Priam, and the rest wondered likewise, and looked upon one another.</p>
          <p>Then spake Priam and made his prayer to him: "Bethink thee of thy father, O Achilles like to gods, whose years are even as mine, on the grievous threshold of old age. Him haply are the dwellers round about entreating evilly, nor is there any to ward from him ruin and bane. Yet truly while he heareth of thee as still alive he rejoiceth in his heart, and hopeth every day that he shall see his dear son returning from Troy-land. But I am all-hapless, since I had the best sons in broad Troy-land, and of them I deem not one is left."</p>
          <p>So spake he, and stirred in Achilles desire to make lament for his father; and he touched the old man's hand and gently put him from him. And the twain bethought them of their dead and wept; and Priam wept sore for Hector the man-slayer, as he lay before Achilles' feet; and Achilles wept for his own father, and now again for Patroklos; and the sound of their mourning rose throughout the house.</p>
          <p>But when noble Achilles was satisfied with lament, and the desire thereof had gone from his heart and limbs, straightway he sprang from his seat and raised the old man by his hand, pitying his grey head and grey beard, and spake unto him winged words: "Ah, hapless! Many ill things verily thou hast endured in thy heart. How hadst thou daring to come alone to the ships of the Achaeans, and meet the eyes of the man who hath slain full many of thy brave sons?"</p>
          <p>"Nay sit thou down upon this seat, and we will let our sorrows lie quiet in our hearts for all our grief; for there is no profit in chill lament. For thus have the gods spun the thread for miserable men, that they should live in pain; yet themselves are sorrowless."</p>
          <p class="trans-attribution">— Lang, Leaf &amp; Myers (1882), Book XXIV, ll. 477–526 (selected)</p>
        </div>
      </div>

      <!-- Original layer -->
      <div id="layer-original" class="layer-panel" role="tabpanel" aria-labelledby="tab-original">
        <div class="layer-demo-banner">
          <span style="font: 400 12px/1.4 var(--mono); color: var(--text-3);">{tr.demo_content_marker}</span>
        </div>
        <div class="trans-header">
          <p style="font: 400 16px/1.5 var(--serif); margin-bottom: 4px;">Ancient Greek — after Monro &amp; Allen OCT</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">Iliad XXIV.477–551 (selected lines)</p>
        </div>
        <pre class="original-text" lang="el">
Πρίαμος δὲ μέγας εἰσῆλθε λαθών, στῆ δ᾽ ἄγχι καὶ ἔλλαβε γούνων
Ἀχιλλῆος, κύσε δὲ χεῖρας δεινὰς ἀνδροφόνους,
αἵ οἱ πολλοὺς υἷας ἐπέφνον.

ὡς δ᾽ ὅτ᾽ ἂν ἄνδρ᾽ ἄτη πυκινὴ λάβῃ, ὅς τ᾽ ἐνὶ πάτρῃ
φῶτα κατακτείνας ἄλλων ἐξίκετο δῆμον,
ἀνδρὸς ἐς ἀφνειοῦ, θάμβος δ᾽ ἔχει εἰσορόωντας·
ὣς Ἀχιλεὺς θάμβησεν ἰδὼν Πρίαμον θεοειδέα·
θάμβησαν δὲ καὶ ἄλλοι.

μνῆσαι πατρὸς σοῖο θεοῖς ἐπιείκελ᾽ Ἀχιλλεῦ,
τηλίκου ὥς περ ἐγών, ὀλοῷ ἐπὶ γήραος οὐδῷ·
        </pre>
      </div>

      <!-- Scholaria layer -->
      <div id="layer-scholaria" class="layer-panel" role="tabpanel" aria-labelledby="tab-scholaria">
        <div class="schol-header-badge">
          <button class="badge con" aria-label={`${tr.tier_button_aria_prefix}${tr.iliad_frag_badge_scholaria_head}`} aria-expanded="false" style="cursor: default; pointer-events: none;">
            <span>{tr.iliad_frag_badge_scholaria_head}</span>
          </button>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.schol_manuscript_status}</span>
            <button class="badge doc" style="cursor: default; pointer-events: none;">{tr.badge_documented}</button>
          </div>
          <div class="schol-body">
            <p>{tr.iliad_frag_ransom_schol_ms_p}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.schol_textual_history}</span>
            <button class="badge doc" style="cursor: default; pointer-events: none;">{tr.badge_documented}</button>
          </div>
          <div class="schol-body">
            <p>{tr.iliad_frag_ransom_schol_hist_p}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head">
            <span>{tr.iliad_frag_ransom_schol_debate_head}</span>
            <button class="badge con" style="cursor: default; pointer-events: none;">{tr.badge_contested}</button>
          </div>
          <div class="schol-body">
            <p>{tr.iliad_frag_ransom_schol_debate_p}</p>
          </div>
        </div>

        <div class="schol-section">
          <div class="schol-head"><span>{tr.schol_scholarship_cited}</span></div>
          <ul class="schol-cite">
            <li><span set:html={tr.iliad_frag_ransom_cite_nagy_html} /></li>
            <li><span set:html={tr.iliad_frag_ransom_cite_whitman_html} /></li>
            <li><span set:html={tr.iliad_frag_ransom_cite_west_html} /></li>
            <li><span set:html={tr.iliad_frag_ransom_cite_kirk_html} /></li>
          </ul>
        </div>
      </div>

      <button type="button" class="structure-toggle" id="structure-toggle" aria-expanded="false" aria-controls="track-view">
        {tr.show_structure}
      </button>
    </div>

    <!-- Annotation tracks -->
    <div class="track-view" id="track-view" role="region" aria-label={tr.track_region_aria} hidden aria-hidden="true">
      <p class="track-view-head">{tr.iliad_frag_track_head}</p>

      <!-- Propp track -->
      <div class="track-row">
        <div class="track-label">{tr.iliad_frag_track_head.split('·')[0].trim()} PROPP</div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_propp_aria}>

          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-8: ${tr.iliad_frag_propp8_name}${tr.annot_aria_comma_tier_reconstructed}`} tabindex="0">
            <p class="annot-code">PROPP-8</p>
            <p class="annot-name">{tr.iliad_frag_propp8_name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_propp8_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_propp8_panel_p}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_reconstructed}</p>
              <p class="meta-line">{tr.meta_annotated_by_pantelia}</p>
            </div>
          </div>

          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-19: ${tr.iliad_frag_propp19_name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">PROPP-19</p>
            <p class="annot-name">{tr.iliad_frag_propp19_name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_propp19_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_propp19_panel_p}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_pantelia}</p>
            </div>
          </div>

          <div class="annot-block" role="button" aria-expanded="false" aria-label={`PROPP-31: ${tr.iliad_frag_propp31_name}${tr.annot_aria_comma_tier_documented}`} tabindex="0">
            <p class="annot-code">PROPP-31</p>
            <p class="annot-name">{tr.iliad_frag_propp31_name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_propp31_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_propp31_panel_p}</p>
              <p class="meta-line">{tr.meta_confidence_colon} {tr.badge_documented}</p>
              <p class="meta-line">{tr.meta_annotated_by_pantelia}</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Campbell track -->
      <div class="track-row">
        <div class="track-label">CAMPBELL</div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_campbell_aria}>

          <div class="annot-block" role="button" aria-expanded="false" tabindex="0">
            <p class="annot-code">Campbell</p>
            <p class="annot-name">{tr.iliad_frag_campbell_return_name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_campbell_return_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_campbell_return_panel_p}</p>
            </div>
          </div>

          <div class="annot-block" role="button" aria-expanded="false" tabindex="0">
            <p class="annot-code">Campbell</p>
            <p class="annot-name">{tr.iliad_frag_campbell_atone_name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_campbell_atone_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_campbell_atone_panel_p}</p>
            </div>
          </div>

        </div>
      </div>

      <!-- TMI track -->
      <div class="track-row">
        <div class="track-label">TMI</div>
        <div class="annot-row" role="group" aria-label={tr.annot_group_tmi_aria}>

          <div class="annot-block" role="button" aria-expanded="false" tabindex="0">
            <p class="annot-code">P325</p>
            <p class="annot-name">{tr.iliad_frag_tmi_p325_name}</p>
            <button class="badge doc" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_documented}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_tmi325_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_tmi_p325_panel_p}</p>
            </div>
          </div>

          <div class="annot-block" role="button" aria-expanded="false" tabindex="0">
            <p class="annot-code">T211.9</p>
            <p class="annot-name">{tr.iliad_frag_tmi_t211_name}</p>
            <button class="badge rec" style="cursor: default; font-size: 10px; pointer-events: none;">{tr.iliad_frag_badge_annot_reconstructed}</button>
            <div class="annot-panel">
              <div class="annot-panel-head">{tr.iliad_frag_tmi211_panel_head} <button class="annot-panel-close">{tr.close_x}</button></div>
              <p>{tr.iliad_frag_tmi_t211_panel_p}</p>
            </div>
          </div>

        </div>
      </div>

      <div class="inactive-tracks">
        <button class="add-track" aria-pressed="false">{tr.inactive_track_bakhtin}</button>
        <button class="add-track" aria-pressed="false">{tr.inactive_track_levi_strauss}</button>
      </div>
    </div>

    <nav class="ep-nav" aria-label={tr.ep_nav_adjacent_aria}>
      <a href={prevHref} rel="prev">{tr.iliad_book24_nav_prev}</a>
      <a href={nextHref} rel="next">{tr.iliad_book24_nav_return_overview}</a>
    </nav>

  </div>
</BaseLayout>

<style>
  .page-body { padding-inline: var(--mx); padding-block: 40px 0; max-width: calc(var(--col) + var(--mx) * 2); margin-inline: auto; }
  .nas-row { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .nas-addr { font: 400 11px/1.4 var(--mono); color: var(--text-3); }
  .nas-copy { background: none; border: none; cursor: pointer; font: 500 11px/1.4 var(--mono); color: var(--link); text-decoration: underline; text-underline-offset: 2px; padding: 0; }
  .nas-copy:hover { color: var(--link-h); }
  .copied-confirm { font: 400 11px/1.4 var(--mono); color: var(--tier-doc); display: none; }
  .ep-heading { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 6px; }
  .ep-title { font: 500 24px/1.3 var(--serif); }
  .ep-sub { font: 400 14px/1.5 var(--serif); color: var(--text-3); margin-bottom: 4px; }
  .ai-lead { font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 0; }
  .badge { display: inline-flex; align-items: center; gap: 5px; font: 500 11px/1.4 var(--mono); padding: 2px 8px; border: 1px solid currentColor; border-radius: 2px; cursor: pointer; position: relative; user-select: none; background: transparent; vertical-align: middle; }
  .badge:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ins { color: var(--tier-ins); } .doc { color: var(--tier-doc); } .rec { color: var(--tier-rec); } .con { color: var(--tier-con); }
