---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/chrome/Breadcrumb.astro';
import TierBadge from '~/components/epistemic/TierBadge.astro';
import { t, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const textTiers = [
  {
    tier: 'documented' as const,
    label: tr.tier_documented,
    desc: tr.tier_documented_desc,
    example: tr.epistemic_tiers_documented_example,
  },
  {
    tier: 'reconstructed' as const,
    label: tr.tier_reconstructed,
    desc: tr.tier_reconstructed_desc,
    example: tr.epistemic_tiers_reconstructed_example,
  },
  {
    tier: 'contested' as const,
    label: tr.tier_contested,
    desc: tr.tier_contested_desc,
    example: tr.epistemic_tiers_contested_example,
  },
  {
    tier: 'inspired' as const,
    label: tr.tier_ai_reviewed,
    desc: tr.tier_ai_reviewed_desc,
    example: tr.epistemic_tiers_ai_reviewed_example,
  },
];

const imageryTiers = [
  { tier: 'documented' as const,    desc: tr.epistemic_tiers_img_documented_desc    },
  { tier: 'reconstructed' as const, desc: tr.epistemic_tiers_img_reconstructed_desc },
  { tier: 'contested' as const,     desc: tr.epistemic_tiers_img_contested_desc     },
  { tier: 'inspired' as const,   desc: tr.epistemic_tiers_img_ai_reviewed_desc   },
];
---

<BaseLayout title={tr.footer_epistemic} locale={locale}>
  <div class="page-body">

    <Breadcrumb locale={locale} crumbs={[
      { label: tr.bc_home, href: `/${locale}/` },
      { label: tr.footer_epistemic },
    ]} />

    <h1 class="page-title">{tr.footer_epistemic}</h1>

    <div class="intro-block">
      <p class="body-p">{tr.epistemic_tiers_intro_p1}</p>
      <p class="body-p">{tr.epistemic_tiers_intro_p2}</p>
    </div>

    <!-- Text content tiers -->
    <h2 class="section-head">{tr.epistemic_tiers_section_text_head}</h2>
    <div class="tier-cards">
      {textTiers.map(({ tier, desc, example }) => (
        <div class="tier-card">
          <div class="tier-card-head">
            <TierBadge tier={tier} locale={locale} />
          </div>
          <p class="tier-card-desc">{desc}</p>
          <p class="tier-card-example">
            <span class="example-label">Example:&nbsp;</span>{example}
          </p>
        </div>
      ))}
    </div>

    <!-- Imagery tiers -->
    <h2 class="section-head">{tr.epistemic_tiers_imagery_head}</h2>
    <p class="body-p section-intro">{tr.epistemic_tiers_imagery_intro}</p>
    <div class="imagery-table">
      {imageryTiers.map(({ tier, desc }) => (
        <div class="imagery-row">
          <div class="imagery-badge">
            <TierBadge tier={tier} locale={locale} />
          </div>
          <p class="imagery-desc">{desc}</p>
        </div>
      ))}
    </div>

    <!-- Candidates -->
    <h2 class="section-head">{tr.epistemic_tiers_candidates_head}</h2>
    <p class="body-p">{tr.epistemic_tiers_candidates_body}</p>

  </div>
</BaseLayout>

<style>
  .page-body {
    padding-inline: var(--mx);
    padding-block: 40px 64px;
    max-width: calc(var(--col) + var(--mx) * 2);
    margin-inline: auto;
  }
  .page-title {
    font: 500 24px/1.3 var(--serif);
    margin-bottom: 24px;
  }
  .intro-block {
    max-width: var(--col);
    margin-bottom: 40px;
  }
  .body-p {
    font: 400 16px/1.7 var(--serif);
    margin-bottom: 16px;
    max-width: var(--col);
  }
  .section-head {
    font: 500 11px/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 20px;
    padding-top: 32px;
    border-top: 1px solid var(--border-2);
  }
  .section-intro {
    margin-bottom: 20px;
  }

  /* Text tier cards */
  .tier-cards {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-bottom: 8px;
    border: 1px solid var(--border-2);
  }
  .tier-card {
    background: var(--surface);
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-2);
  }
  .tier-card:last-child { border-bottom: none; }
  .tier-card-head {
    margin-bottom: 10px;
  }
  .tier-card-desc {
    font: 400 15px/1.5 var(--serif);
    margin-bottom: 8px;
  }
  .tier-card-example {
    font: 400 13px/1.5 var(--serif);
    color: var(--text-2);
  }
  .example-label {
    font: 400 11px/1.4 var(--mono);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Imagery table */
  .imagery-table {
    border: 1px solid var(--border-2);
    margin-bottom: 8px;
  }
  .imagery-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-2);
    background: var(--surface);
  }
  .imagery-row:last-child { border-bottom: none; }
  .imagery-badge {
    flex-shrink: 0;
    min-width: 148px;
  }
  .imagery-desc {
    font: 400 14px/1.5 var(--serif);
    color: var(--text-2);
  }

  @media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
  @media (max-width: 767px) {
    .page-body { padding-inline: var(--mx-m); }
    .imagery-row { flex-direction: column; gap: 8px; }
    .imagery-badge { min-width: auto; }
  }
</style>
