---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/chrome/Breadcrumb.astro';
import ParallelStructureDiagram from '~/components/visualizations/ParallelStructureDiagram.astro';
import { t, type Locale } from '~/i18n';
import { withBase } from '~/utils/url';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const tr = t(locale);
const navBase = withBase(`/${locale}`);
---

<BaseLayout title={tr.iliad_parallel_heading} locale={locale}>
  <div class="page-body">

    <Breadcrumb locale={locale} crumbs={[
      { label: tr.bc_home,             href: `${navBase}/` },
      { label: tr.bc_cross_resonances, href: `${navBase}/parallels/` },
      { label: tr.iliad_parallel_heading },
    ]} />

    <!-- Back link -->
    <a
      href={`${navBase}/iliad/`}
      style="font: 400 14px/1.5 var(--serif); display: block; margin-bottom: 24px;"
    >
      {tr.iliad_parallel_view_back}
    </a>

    <!-- Parallel header -->
    <header class="par-header" aria-label={tr.iliad_parallel_heading}>
      <h1 style="font: 500 26px/1.3 var(--serif); margin-bottom: 8px;">{tr.iliad_parallel_heading}</h1>
      <p style="font: 400 14px/1.5 var(--serif); color: var(--text-2); margin-bottom: 16px;">
        {tr.parallel_type_structural}
      </p>
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <span class="badge badge--rec">{tr.badge_reconstructed}</span>
        <span style="font: 400 11px/1.4 var(--mono); color: var(--text-3);">
          {tr.iliad_parallel_attributed_pantelia}
        </span>
      </div>
    </header>

    <hr class="div" />

    <!-- Structural beat diagram -->
    <ParallelStructureDiagram
      locale={locale}
      trad1Label={tr.iliad_parallel_label_greek}
      trad2Label={tr.iliad_parallel_label_mesop}
      caption={tr.parallel_diagram_caption_grief}
      beats={[
        { id: 'b1', label: locale === 'ru' ? 'Гибель спутника'      : "Companion's Death",       trad1: locale === 'ru' ? 'Патрокл убит Гектором; Ахилл ранее предупреждён, но отослал его в своих доспехах'      : 'Patroclus slain by Hector; Achilles had warned him but sent him in his armour',          trad2: locale === 'ru' ? 'Энкиду умирает по воле богов, несмотря на заступничество Эа'                         : 'Enkidu dies by divine decree despite Ea\'s plea' },
        { id: 'b2', label: locale === 'ru' ? 'Отказ и горе'         : 'Refusal and Grief',       trad1: locale === 'ru' ? 'Ахилл отказывается хоронить Патрокла до мести; неутешно рыдает'                         : 'Achilles refuses to bury Patroclus until revenge; weeps inconsolably',                    trad2: locale === 'ru' ? 'Гильгамеш отказывается от погребения семь дней и ночей'                              : 'Gilgamesh refuses burial for seven days and nights',                                   diverges: true },
        { id: 'b3', label: locale === 'ru' ? 'Путь-противостояние'  : 'Journey / Confrontation', trad1: locale === 'ru' ? 'Приам совершает ночной путь в стан врага, чтобы умолить Ахилла'                        : "Priam makes a night journey through enemy lines to plead with Achilles",                  trad2: locale === 'ru' ? 'Гильгамеш отправляется на край мира в поисках Утнапиштима'                           : 'Gilgamesh journeys to the edge of the world to find Utnapishtim',                     diverges: true },
        { id: 'b4', label: locale === 'ru' ? 'Неожиданная встреча'  : 'Unexpected Encounter',    trad1: locale === 'ru' ? 'Ахилл плачет с Приамом и возвращает тело Гектора; оба оплакивают своих умерших'         : 'Achilles weeps with Priam and returns Hector\'s body; both mourn their dead',            trad2: locale === 'ru' ? 'Утнапиштим рассказывает о потопе; бессмертие не даровано'                            : 'Utnapishtim recounts the flood; immortality is withheld',                              diverges: true },
        { id: 'b5', label: locale === 'ru' ? 'Принятие / погребение': 'Acceptance / Burial',     trad1: locale === 'ru' ? 'Гектор погребён; плач; поэма завершается'                                               : 'Hector receives burial; mourning; the poem ends',                                         trad2: locale === 'ru' ? 'Возвращение в Урук без бессмертия; стены города стоят'                              : 'Return to Uruk without immortality; the walls endure' },
      ]}
    />

    <hr class="div" />

    <!-- Two-column tradition passages -->
    <section aria-label={tr.parallel_passages_section_aria} class="passages-grid">

      <!-- Greek / Iliad panel -->
      <div class="tradition-panel" aria-label={tr.parallel_panel_greek_passage_aria}>
        <p class="trad-label" style="color: var(--greek);">{tr.iliad_parallel_label_greek}</p>
        <div class="panel-body">
          <h2 style="font: 500 18px/1.4 var(--serif); margin-bottom: 4px;">{tr.idx_title_iliad}</h2>
          <p style="font: 400 13px/1.4 var(--mono); color: var(--text-2); margin-bottom: 2px;">{tr.iliad_parallel_iliad_sub}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 6px;">{tr.iliad_parallel_iliad_date}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 16px;">{tr.layer_static_2_translated}</p>
          <span class="badge badge--doc" style="display: inline-block; margin-bottom: 4px;">{tr.badge_documented}</span>
          <span style="font: 400 11px/1.4 var(--mono); color: var(--text-3); display: block; margin-bottom: 16px;">{tr.iliad_parallel_credit_iliad}</span>
          <hr class="panel-div" />
          <blockquote class="passage" lang="en">
            <p><a href="#beat-b3" class="motif-anchor" id="motif-b3" aria-label={tr.motif_anchor_aria}>◇3</a> Priam the old man passed within the house and found Achilles, dear to Zeus, sitting apart, and the heroes were seated apart. And two alone, Automedon and Alkimos, of the stock of Ares, were busy in attendance; for Achilles had but newly ceased from meat and drink, and the table was still standing by him.</p>
            <p>And great Priam entered unnoticed, and stood near, and clasped the knees of Achilles, and kissed his terrible man-slaying hands that had slain so many of Priam's sons.</p>
            <p>And as when a mighty woe cometh upon a man who in his own country hath slain another, and he cometh to the land of strangers, to a rich man's house, and wonder holdeth them that see him — so Achilles wondered when he saw godlike Priam, and the rest wondered likewise, and looked upon one another.</p>
            <p>Then spake Priam and made his prayer: "Bethink thee of thy father, O Achilles like to gods, whose years are even as mine, on the grievous threshold of old age. Yet truly while he heareth of thee as still alive he rejoiceth in his heart, and hopeth every day that he shall see his dear son returning from Troy-land. But I am all-hapless, since I had the best sons in broad Troy-land, and I deem that not one of them is left."</p>
            <p><a href="#beat-b4" class="motif-anchor" id="motif-b4" aria-label={tr.motif_anchor_aria}>◇4</a> So spake he, and stirred in Achilles desire to make lament for his father; and he took the old man's hand and gently put him from him. And the two bethought them of their dead and wept; and Priam wept sore for Hector the man-slayer, as he lay before Achilles' feet; and Achilles wept for his own father, and now again for Patroclus; and the sound of their mourning rose throughout the house.</p>
          </blockquote>
          <p class="attr">{tr.iliad_parallel_attr_iliad}</p>
          <a
            href={`${navBase}/iliad/book-xxiv/ransom-of-hector/`}
            style="font: 500 13px/1.4 var(--serif); display: inline-block; margin-top: 12px;"
          >
            {tr.iliad_parallel_fragment_link}
          </a>
        </div>
      </div>

      <!-- Mesopotamian / Gilgamesh panel -->
      <div class="tradition-panel" aria-label={tr.parallel_panel_mesop_passage_aria}>
        <p class="trad-label" style="color: var(--mesop);">{tr.iliad_parallel_label_mesop}</p>
        <div class="panel-body">
          <h2 style="font: 500 18px/1.4 var(--serif); margin-bottom: 4px;">{tr.parallel_view_epi_title}</h2>
          <p style="font: 400 13px/1.4 var(--mono); color: var(--text-2); margin-bottom: 2px;">{tr.iliad_parallel_epi_sub_enkidu}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 6px;">{tr.parallel_view_epi_date_sbv}</p>
          <p style="font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 16px;">{tr.layer_static_2_translated}</p>
          <span class="badge badge--doc" style="display: inline-block; margin-bottom: 4px;">{tr.badge_documented}</span>
          <span style="font: 400 11px/1.4 var(--mono); color: var(--text-3); display: block; margin-bottom: 16px;">{tr.parallel_view_credit_thompson}</span>
          <hr class="panel-div" />
          <blockquote class="passage" lang="en">
            <p><a href="#beat-b1" class="motif-anchor" id="motif-b1" aria-label={tr.motif_anchor_aria}>◇1</a> Gilgamesh bemoaned Enkidu, his friend, weeping bitterly over him:</p>
            <p><a href="#beat-b2" class="motif-anchor" id="motif-b2" aria-label={tr.motif_anchor_aria}>◇2</a> "Enkidu, my friend, whom I loved more than all labours that I did —<br>
            he who with me ranged the wilderness and slew the lion,<br>
            he who with me took Humbaba in the Cedar Forest —<br>
            what is the sleep that hath seized thee now?"</p>
            <p>He touched his heart but it did not beat. He covered Enkidu's face as one covers a bride. Like an eagle he circled over him. Like a lioness whose whelps are taken he paced to and fro. He tore out his hair and threw it from him.</p>
          </blockquote>
          <p class="attr">{tr.iliad_parallel_attr_gilgamesh}</p>
          <p style="font: 400 12px/1.5 var(--serif); color: var(--text-3); margin-top: 12px;">
            {tr.iliad_parallel_gilgamesh_phase_note}
          </p>
        </div>
      </div>

    </section>

    <hr class="div" />

    <!-- Scholarly note -->
    <section aria-labelledby="note-heading" class="scholar-note">
      <h2 id="note-heading" style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 24px;">
        {tr.schol_note_heading}
      </h2>

      <div class="note-section">
        <h3 style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; margin-bottom: 10px;">
          {tr.iliad_parallel_note_what_head}
        </h3>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px;">{tr.iliad_parallel_note_what_p1}</p>
        <p style="font: 400 16px/1.7 var(--serif);">{tr.iliad_parallel_note_what_p2}</p>
      </div>

      <div class="note-section">
        <h3 style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; margin-bottom: 10px;">
          {tr.iliad_parallel_note_why_head}
        </h3>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px;">{tr.iliad_parallel_note_why_p1}</p>
        <p style="font: 400 16px/1.7 var(--serif);">{tr.iliad_parallel_note_why_p2}</p>
      </div>

      <div class="note-section">
        <h3 style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; margin-bottom: 10px;">
          {tr.iliad_parallel_note_diverge_head}
        </h3>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px;">{tr.iliad_parallel_note_diverge_p1}</p>
        <p style="font: 400 16px/1.7 var(--serif);">{tr.iliad_parallel_note_diverge_p2}</p>
      </div>

      <div class="note-section">
        <h3 style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; margin-bottom: 10px;">
          {tr.iliad_parallel_note_reveals_head}
        </h3>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px;">{tr.iliad_parallel_note_reveals_p1}</p>
        <p style="font: 400 16px/1.7 var(--serif); margin-bottom: 16px;">{tr.iliad_parallel_note_reveals_p2}</p>
        <p style="font: 400 16px/1.7 var(--serif);">{tr.iliad_parallel_note_reveals_p3}</p>
      </div>

      <div class="note-section">
        <h3 style="font: 500 13px/1.4 var(--mono); letter-spacing: 0.06em; margin-bottom: 10px;">
          {tr.parallel_view_note_scholarship_head}
        </h3>
        <ul class="cite-list">
          <li><span set:html={tr.iliad_parallel_cite_nagy_html} /></li>
          <li><span set:html={tr.iliad_parallel_cite_schein_html} /></li>
          <li><span set:html={tr.iliad_parallel_cite_george_iliad_html} /></li>
          <li><span set:html={tr.iliad_parallel_cite_shay_html} /></li>
        </ul>
      </div>

    </section>

  </div>
</BaseLayout>

<style>
.page-body {
  padding-inline: var(--mx);
  padding-block: 40px 0;
}

.par-header {
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-left: 3px solid var(--tier-rec);
  padding: 28px;
  margin-bottom: 40px;
  max-width: var(--col-wide, 900px);
}

.badge {
  font: 500 11px/1.4 var(--mono);
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border: 1px solid currentColor;
}
.badge--doc { color: var(--tier-doc); }
.badge--rec { color: var(--tier-rec); }

.passages-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 40px;
}

.tradition-panel { display: flex; flex-direction: column; }

.trad-label {
  font: 500 11px/1.4 var(--mono);
  letter-spacing: 0.08em;
  color: var(--text-3);
  margin-bottom: 12px;
  white-space: nowrap;
  overflow: hidden;
}

.panel-body {
  background: var(--surface);
  border: 1px solid var(--border-2);
  padding: 24px;
  flex: 1;
}

.panel-div {
  border: none;
  border-top: 1px solid var(--border-2);
  margin-block: 16px;
}

.passage {
  font: 400 15px/1.7 var(--serif);
  border-left: 2px solid var(--border-2);
  padding-left: 16px;
  margin: 0 0 12px 0;
}
.passage p { margin-bottom: 8px; }
.passage p:last-child { margin-bottom: 0; }

.attr { font: 400 11px/1.4 var(--mono); color: var(--text-3); margin-bottom: 4px; }

.motif-anchor {
  font: 500 10px/1 var(--mono);
  color: var(--tier-ins);
  text-decoration: none;
  margin-right: 4px;
  vertical-align: super;
}
.motif-anchor:hover { text-decoration: underline; }

.scholar-note {
  max-width: var(--col);
  margin-bottom: 40px;
}

.note-section {
  border-top: 1px solid var(--border-2);
  padding: 24px 0;
}
.note-section:last-child { border-bottom: 1px solid var(--border-2); }

.cite-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.cite-list li {
  font: 400 14px/1.6 var(--serif);
  color: var(--text-2);
  margin-bottom: 8px;
  padding-left: 16px;
  position: relative;
}
.cite-list li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--text-3);
}

@media (max-width: 1279px) { .page-body { padding-inline: var(--mx-t); } }
@media (max-width: 767px) {
  .page-body { padding-inline: var(--mx-m); }
  .passages-grid { grid-template-columns: 1fr; }
}
</style>
