---
import type { CampbellStage } from '~/content.config';
import TierBadge from '~/components/epistemic/TierBadge.astro';
import type { Locale } from '~/i18n';

interface Props {
  stages?: CampbellStage[];
  tradition?: 'mesopotamian' | 'greek';
  locale?: Locale;
}

const { stages, tradition = 'mesopotamian', locale = 'en' } = Astro.props;

const ALL_STAGES = [
  'The Call to Adventure', 'Refusal of the Call', 'Supernatural Aid',
  'Crossing the First Threshold', 'Belly of the Whale',
  'The Road of Trials', 'The Meeting with the Goddess', 'Temptation',
  'Atonement with the Father', 'Apotheosis', 'The Ultimate Boon',
  'Refusal of the Return', 'The Magic Flight', 'Rescue from Without',
  'Crossing the Return Threshold', 'Master of Two Worlds',
  'Return with the Elixir',
];

const activeNames = new Set((stages ?? []).map(s => s.stage));
const activeMap = new Map((stages ?? []).map(s => [s.stage, s]));
const accentColor = tradition === 'greek' ? 'var(--greek)' : 'var(--mesop)';
const accentBg = tradition === 'greek' ? 'var(--greek-bg)' : 'var(--mesop-bg)';

const heading = locale === 'ru' ? 'Мономиф Кэмпбелла' : 'Campbell Monomyth';
const caption = locale === 'ru'
  ? '▲ ПРОВЕРЕНО ИИ · Активные стадии выделены · по Кэмпбеллу (1949)'
  : '▲ AI-REVIEWED · Active stages highlighted · after Campbell (1949)';

const total = ALL_STAGES.length;
const cx = 120;
const cy = 120;
const r = 90;

function polarToXY(index: number, total: number): { x: number; y: number } {
  const angle = (index / total) * 2 * Math.PI - Math.PI / 2;
  return {
    x: cx + r * Math.cos(angle),
    y: cy + r * Math.sin(angle),
  };
}
---

<div class="mono-wrap" aria-label={heading} aria-hidden={!stages || stages.length === 0 ? 'true' : undefined} style={!stages || stages.length === 0 ? 'display:none' : undefined}>
  <p class="viz-heading">{heading}</p>
  <div class="mono-body">
    <svg
      class="mono-arc"
      viewBox="0 0 240 240"
      aria-hidden="true"
      role="presentation"
    >
      <circle cx={cx} cy={cy} r={r} fill="none" stroke="var(--border-2)" stroke-width="1" />
      {ALL_STAGES.map((name, i) => {
        const { x, y } = polarToXY(i, total);
        const active = activeNames.has(name);
        return (
          <circle
            cx={x}
            cy={y}
            r={active ? 7 : 4}
            fill={active ? accentColor : 'var(--surface)'}
            stroke={active ? accentColor : 'var(--border-2)'}
            stroke-width="1"
          >
            <title>{name}</title>
          </circle>
        );
      })}
      <text x={cx} y={cy - 8} text-anchor="middle" font-size="10" fill="var(--text-3)" font-family="var(--mono)">
        CAMPBELL
      </text>
      <text x={cx} y={cy + 6} text-anchor="middle" font-size="10" fill="var(--text-3)" font-family="var(--mono)">
        HERO'S
      </text>
      <text x={cx} y={cy + 18} text-anchor="middle" font-size="10" fill="var(--text-3)" font-family="var(--mono)">
        JOURNEY
      </text>
    </svg>

    <div class="mono-legend">
      {stages && stages.length > 0 ? (
        <>
          <p class="legend-head">
            {locale === 'ru' ? 'Стадии в этом эпизоде:' : 'Stages in this episode:'}
          </p>
          {stages.map(s => (
            <div class="legend-row">
              <span class="legend-dot" style={`background: ${accentColor};`} aria-hidden="true" />
              <span class="legend-name">{s.stage}</span>
              <TierBadge tier={s.tier} locale={locale} />
            </div>
          ))}
        </>
      ) : (
        <p class="legend-absent">
          {locale === 'ru'
            ? 'Данные о стадиях Кэмпбелла для этого эпизода ещё не подготовлены.'
            : 'Campbell stage data for this episode is not yet authored.'}
        </p>
      )}
    </div>
  </div>
  <p class="viz-caption" aria-hidden="true">{caption}</p>
</div>

<style>
.mono-wrap {
  margin-block: 24px;
}

.viz-heading {
  font: 500 11px/1.4 var(--mono);
  letter-spacing: 0.08em;
  color: var(--text-3);
  margin-bottom: 10px;
}

.mono-body {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  flex-wrap: wrap;
}

.mono-arc {
  width: 180px;
  height: 180px;
  flex-shrink: 0;
}

.mono-legend {
  flex: 1;
  min-width: 180px;
}

.legend-head {
  font: 500 11px/1.4 var(--mono);
  color: var(--text-2);
  margin-bottom: 8px;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-name {
  font: 400 12px/1.4 var(--serif);
  color: var(--text-2);
  flex: 1;
}

.legend-absent {
  font: 400 12px/1.5 var(--serif);
  color: var(--text-3);
  font-style: italic;
}

.viz-caption {
  font: 400 11px/1.4 var(--mono);
  color: var(--text-3);
  margin-top: 10px;
}
</style>
