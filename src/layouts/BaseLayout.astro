---
import Header from '~/components/chrome/Header.astro';
import Footer from '~/components/chrome/Footer.astro';
import Analytics from '~/components/chrome/Analytics.astro';
import { t, type Locale } from '~/i18n';
import '~/styles/global.css';

interface Props {
  title: string;
  locale: Locale;
  description?: string;
}

const { title, locale, description } = Astro.props;
const tr = t(locale);
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Mnemosyne Engine</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <Analytics />
</head>
<body>
  <a href="#main" class="skip">{tr.skip_to_main}</a>
  <Header locale={locale} />
  <main id="main">
    <slot />
  </main>
  <Footer locale={locale} />
</body>
</html>
