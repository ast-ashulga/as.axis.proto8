---
/**
 * Dynamic Tablet Hub Route
 *
 * Generates one page per {locale, tradition, division} combination,
 * grouping episodes that share the same tradition+division from their NAS.
 *
 * Existing static pages (e.g. en/gilgamesh/tablet-xi/index.astro) take
 * priority over this dynamic route in Astro's routing resolution.
 *
 * Phase2 filtering is delegated to <TabletHub />.
 */
import { getCollection } from 'astro:content';
import TabletHub from '~/components/TabletHub.astro';
import type { Locale } from '~/i18n';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allEpisodes = await getCollection('episodes');
  const locales: Locale[] = ['en', 'ru'];

  type GroupKey = string;
  type GroupValue = {
    locale: Locale;
    tradition: string;
    division: string;
    episodes: CollectionEntry<'episodes'>[];
  };

  const pathMap = new Map<GroupKey, GroupValue>();

  for (const locale of locales) {
    for (const ep of allEpisodes) {
      // Phase2 episodes are never made public (feature flag policy: always off)
      if (ep.data.phase2) continue;

      const nasPath = ep.data.nas.replace('nms://', '');
      const parts   = nasPath.split('/');
      if (parts.length < 3) continue;

      const tradition = parts[0]!;
      const division  = parts[1]!;
      const key       = `${locale}/${tradition}/${division}`;

      if (!pathMap.has(key)) {
        pathMap.set(key, { locale, tradition, division, episodes: [] });
      }
      pathMap.get(key)!.episodes.push(ep);
    }
  }

  return [...pathMap.values()].map(({ locale, tradition, division, episodes }) => ({
    params:  { locale, tradition, division },
    props:   { episodes },
  }));
}

type Props = {
  episodes: CollectionEntry<'episodes'>[];
};

const { locale, tradition, division } = Astro.params as {
  locale: Locale;
  tradition: string;
  division: string;
};
const { episodes } = Astro.props;
---

<TabletHub
  episodes={episodes}
  locale={locale}
  division={division}
  tradition={tradition}
/>
